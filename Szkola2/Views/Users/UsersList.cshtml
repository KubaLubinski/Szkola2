@model IEnumerable<Szkola2.Models.ViewModels.UserViewModel>
@inject Szkola2.Infrastructure.IDemoContext Demo

@{
    ViewData["Title"] = "Lista użytkowników";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">ADMINISTRACJA</span>
            <h1>Lista <span>użytkowników</span></h1>
        </div>

        @if (!Demo.IsDemo)
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-school">
                Dodaj użytkownika <span aria-hidden="true">+</span>
            </a>
        }
    </div>

    <div class="panel-card list-panel">
        <div class="list-inner list-inner-md">
            <table class="table texts-table align-middle">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Email)</th>
                        <th>Imię</th>
                        <th>Nazwisko</th>
                        <th>Konto</th>
                        <th>Rola</th>
                        <th><span class="visually-hidden">Akcje</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="email-col" title="@item.Email" style="max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@item.Email</td>
                            <td class="name-col">@item.FirstName</td>
                            <td class="name-col">@item.LastName</td>
                            <td>
                                @if (item.IsActive == true)
                                {
                                    <span class="status-pill status-on">Aktywne</span>
                                }
                                else
                                {
                                    <span class="status-pill status-off">Nieaktywne</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Role?.ToString()))
                                {
                                    <span class="detail-badge">@item.Role</span>
                                }
                            </td>
                            <td class="list-actions">
                                <a asp-action="UserEdit" asp-route-id="@item.Id" title="Edytuj" aria-label="Edytuj"
                                   class="btn btn-outline-primary rounded-circle bi-pencil-fill"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

