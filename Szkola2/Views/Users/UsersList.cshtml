@model IEnumerable<Szkola2.Models.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "UsersList";
}

<h1>Lista użytkowników</h1>

<p>
    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary roboto mt-3 mb-4">Dodaj użytkownika</a>
</p>
<table class="table text-color">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                Imię
            </th>
            <th>
                Nazwisko
            </th>
            <th>
                Czy konto jest aktywne?
            </th>
            <th>
                Rola
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td class="text-center">
                    @Html.DisplayFor(modelItem => item.IsActive)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Role)
                </td>
                <td>
                    <a asp-action="UserEdit" asp-route-id="@item.Id" class="btn btn-primary">Edytuj</a>
@*                     <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Usuń</a> *@
                </td>
            </tr>
        }
    </tbody>
</table>
