@model Szkola2.Models.History

@{
    ViewData["Title"] = "Usuwanie";
}

<h1  class="text-danger roboto">Usuwanie</h1>

<h3  class="roboto">Czy chcesz usunąć wpis o historii?</h3>
<div>
    
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TextName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TextName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Content)
        </dt>
        <dd class = "col-sm-10">
            @Html.Raw(Model.Content)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <hr />
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Usuń" class="btn btn-danger" /> | 
        <a asp-action="Index" class="btn btn-light">Powrót do histori</a>
    </form>
</div>
