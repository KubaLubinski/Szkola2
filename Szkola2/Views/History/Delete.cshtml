@model Szkola2.Models.History

@{
    ViewData["Title"] = "Usuwanie wpisu o historii";
    var plain = System.Net.WebUtility.HtmlDecode(
        System.Text.RegularExpressions.Regex.Replace(Model.Content ?? "", "<.*?>", " ")).Trim();
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg label-danger">UWAGA</span>
            <h1>Usuwanie <span class="heading-danger">wpisu</span></h1>
        </div>
    </div>

    <div class="panel-card panel-narrow panel-danger">

        <p class="delete-question">Czy na pewno chcesz usunąć ten wpis o historii szkoły? Tej operacji nie można cofnąć.</p>

        <dl class="detail-list">
            <dt>@Html.DisplayNameFor(model => model.TextName)</dt>
            <dd>@Html.DisplayFor(model => model.TextName)</dd>
        </dl>

        <h2 class="form-section-title mt-4">@Html.DisplayNameFor(model => model.Content)</h2>
        <div class="detail-content delete-content">
            @(plain.Length <= 300 ? plain : plain.Substring(0, 300) + " ...")
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="form-actions">
                <button type="submit" class="btn btn-school-danger">Usuń</button>
                <a asp-action="Index" class="btn btn-school-outline">Powrót do historii</a>
            </div>
        </form>

    </div>

</div>

