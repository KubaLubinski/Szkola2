@model Szkola2.Models.History

@{
    ViewData["Title"] = "Szczegóły";
}


<div>
    <h4>Historia szkoły</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TextName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TextName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Content)
        </dt>
        <dd class = "col-sm-10">
            @Html.Raw(Model.Content)
        </dd>
        <dt class="col-sm-2">
            Galeria Zdjęć:
        </dt>
        <dd class="col-sm-10">
            <div id="carouselExample" class="carousel slide">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.GraphicGallery.Count(); i++)
                    {
                        <div class="@(i==0 ? "carousel-item active" : "carousel-item") ">
                            <img class="d-block w-100" src="@Url.Content("~/miniGallery/"+Model.GraphicGallery[i].URL)" alt="@Model.GraphicGallery[i].Name" width="600">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </dd>
    </dl>
</div>
<div>
    <hr />
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Edycja</a> |
    <a asp-action="Index" class="btn btn-light">Powrót do histori</a>
</div>
