@model IEnumerable<Szkola2.Models.History>

@{
    ViewData["Title"] = "List";
}

@{
    foreach (var item in Model)
    {
        <h2 class="text-center">@item.TextName</h2>
        <p>@Html.Raw(item.Content)</p>
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @for (int i = 0; i < item.GraphicGallery.Count(); i++)
            {
              <div class="col">
                <div class="card">
                  <img class="d-block rounded img-fluid mx-auto" src="@Url.Content("~/miniGallery/"+item.GraphicGallery[i].URL)" alt="@item.GraphicGallery[i].Name">
                </div>
              </div>

            }
        </div>
        <hr />
    }
}