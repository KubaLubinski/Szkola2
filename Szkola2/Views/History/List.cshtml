@model IEnumerable<Szkola2.Models.History>

@{
    ViewData["Title"] = "Historia szkoły";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">NASZE KORZENIE</span>
            <h1>Historia <span>szkoły</span></h1>
        </div>
    </div>

    @if (Model.Any())
    {
        @foreach (var item in Model)
        {
            <article class="panel-card history-entry">
                <h2 class="history-title">@item.TextName</h2>

                <div class="detail-content">
                    @Html.Raw(item.Content)
                </div>

                @if (item.GraphicGallery.Count() > 0)
                {
                    <div class="history-gallery">
                        @for (int i = 0; i < item.GraphicGallery.Count(); i++)
                        {
                            <figure class="history-gallery-item">
                                <img src="@Url.Content("~/miniGallery/" + item.GraphicGallery[i].URL)"
                                     alt="@($"{item.TextName} – zdjęcie {i + 1} z {item.GraphicGallery.Count()}")" />
                            </figure>
                        }
                    </div>
                }
            </article>
        }
    }
    else
    {
        <div class="panel-card texts-empty" role="alert">
            <span class="texts-empty-icon" aria-hidden="true">ℹ</span>
            <div>Brak wpisów o historii szkoły.</div>
        </div>
    }

</div>

