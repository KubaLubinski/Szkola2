@model IEnumerable<Szkola2.Models.History>

@{
    ViewData["Title"] = "Index";
}

<h1 class="roboto">Historia szkoły</h1>
@{
    if(User.IsInRole("admin") || User.IsInRole("dyrektor") || User.IsInRole("nauczyciel"))
    {
        <p>
            <a asp-action="Create" class="btn btn-warning">Stwórz nowy wpis</a>
        </p>
    }
}

<table class="table text-color">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TextName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Content)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => item.TextName)
            </td>
            <td>
                @if (item.Content.Length <= 80)
                    {
                        @Html.Raw(item.Content)
                    }
                    else
                    {
                      @Html.Raw(item.Content.Substring(0,80)+" ...")  
                    }
            </td>
            <td>
                
                
                @if (User.IsInRole("admin") || User.IsInRole("dyrektor"))
                {
                    <a class="btn btn-outline-success rounded-circle bi-eye my-1" title="Szczegóły" asp-action="Details" asp-route-id="@item.Id" onmouseover="showtip(this, 'Szczegóły ')" onmouseout="hidetip()"><i aria-label="Szczegóły"> </i></a> 
                    <a class="btn btn-outline-primary rounded-circle bi-pencil-fill my-1" title="Edycja" asp-action="Edit" asp-route-id="@item.Id" onmouseover="showtip(this, 'Edytuj ')" onmouseout="hidetip()"><i  aria-label="Edycja tekstu"> </i></a>
                        <a class="btn btn-outline-danger rounded-circle bi-trash-fill my-1" title="Usuwanie" asp-action="Delete" asp-route-id="@item.Id" onmouseover="showtip(this, 'Usuwanie ')" onmouseout="hidetip()"><i  aria-label="Usuwanie"> </i></a>
                    }
                    else
                    {
                        <a class="btn btn-outline-logoyellow" title="Czytaj" asp-action="Details" asp-route-id="@item.Id"><i aria-label="Szczegóły"> </i> Czytaj >>></a>
                    }
                <div class="tooltip" id="tooltip">Podpowiedź</div>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts{
    <script src="~/js/History.js"></script>
     <script src="/js/Mouseover-out.js" > </script>
}
