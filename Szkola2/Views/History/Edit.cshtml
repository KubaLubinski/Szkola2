@model Szkola2.Models.History

@{
    ViewData["Title"] = "Edycja";
}

@{
    if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert"> @ViewBag.ErrorMessage</div>
    }
}
<h1>Edycja</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="TextName" class="control-label"></label>
                <input asp-for="TextName" class="form-control" />
                <span asp-validation-for="TextName" class="text-danger"></span>
            </div>
            <div class="form-group editor-color">
                <label asp-for="Content" class="control-label text-color"></label>
                <textarea id="editor" asp-for="Content" class="form-control"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <hr />
            <div class="form-group">
                @for (int i = 0; i < Model.HistoryGallerys.Count(); i++)
                {
                    <div>
                        <div class="card">
                            <a asp-action="Details" asp-route-Id="@Model.Id" class="card-img-top">
                                <img class="card-img-top rounded" src="@Model.HistoryGallerys[i].URL" alt="@Model.HistoryGallerys[i].Name" width="150" height="150">
                            </a>
                            <div class="card-body">
                                @*<a class="card-title" asp-action="DeleteOneImage" asp-route-Id="@Model.HistoryGallerys[i].Id">Usuń zdjęcie</a>*@
                                <a class="btn btn-danger card-title form-control" onclick="Delete('/History/DeleteOneImage/@Model.HistoryGallerys[i].Id')">Usuń</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="form-group">
                <label asp-for="HistoryGalleryFiles" class="control-label">Dodaj więcej zdjęć</label>
                <div class="custom-file">
                    <input asp-for="HistoryGalleryFiles" class="custom-file-input" id="customFile" accept=".jpg,.gif,.png">
                    <hr />
                </div>
                <span asp-validation-for="HistoryGalleryFiles" class="text-danger"></span>
            </div>
            <hr />
            <div class="form-group col-md-5">
                @for (int i = 0; i < Model.GraphicGallery.Count(); i++)
                {
                    <div>
                        <div class="card">
                            <a asp-action="Details" asp-route-Id="@Model.Id" class="card-img-top">
                                <img class="card-img-top rounded" src="@Url.Content("~/miniGallery/"+Model.GraphicGallery[i].URL)" alt="@Model.GraphicGallery[i].Name" width="150" height="150">
                            </a>
                            <div class="card-body">
                                <a class="btn btn-danger card-title form-control" onclick="Delete('/PastSchoolEvents/DeleteOneImage/@Model.GraphicGallery[i].Id')">Usuń</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="form-group">
                <label asp-for="GraphicGalleryFiles" class="control-label">Dodaj więcej zdjęć</label>
                <div class="custom-file">
                    <input asp-for="GraphicGalleryFiles" class="custom-file-input" id="customFile" accept=".jpg,.gif,.png">
                    <hr />
                </div>
                <span asp-validation-for="GraphicGalleryFiles" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Zapisz zmiany" class="btn btn-primary" /> |
                <a asp-action="Index" class="btn btn-light">Powrót do historii</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
     <script src="~/lib/ckeditor5/ckeditor.min.js"></script>
     <script src="~/js/History.js"></script>
    <script src="~/lib/ckeditor5/translations/pl.min.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'),{
                language: 'pl'
            })
            .catch(error => {
                console.error(error);
            })
    </script>
}

