@model Szkola2.Models.History

@{
    ViewData["Title"] = "Dodaj wpis o historii";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">NOWY WPIS</span>
            <h1>Dodaj wpis o <span>historii szkoły</span></h1>
        </div>
    </div>

    @if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ViewBag.ErrorMessage</div>
    }

    <form asp-action="Create" enctype="multipart/form-data" class="panel-card panel-narrow">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-section">
            <h2 class="form-section-title">Treść</h2>

            <div class="form-field">
                <label asp-for="TextName" class="form-label fw-bold"></label>
                <input asp-for="TextName" class="form-control" />
                <span asp-validation-for="TextName" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Content" class="form-label fw-bold"></label>
                <textarea id="editor" asp-for="Content" class="form-control"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
        </div>

        <div class="form-section">
            <h2 class="form-section-title">Zdjęcia</h2>

            <div class="form-field">
                <label asp-for="GraphicGalleryFiles" class="form-label fw-bold">Dodaj wiele zdjęć do wpisu</label>
                <input asp-for="GraphicGalleryFiles" class="form-control" id="customFile" accept=".jpg,.gif,.png">
                <span asp-validation-for="GraphicGalleryFiles" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-school">Dodaj <span aria-hidden="true">→</span></button>
            <a asp-action="Index" class="btn btn-school-outline">Powrót do historii</a>
        </div>
    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/ckeditor5/ckeditor.min.js"></script>
    <script src="~/lib/ckeditor5/translations/pl.min.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'), {
                language: 'pl'
            })
            .catch(error => {
                console.error(error);
            })
    </script>
}

