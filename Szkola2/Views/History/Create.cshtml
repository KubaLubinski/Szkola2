@model Szkola2.Models.History

@{
    ViewData["Title"] = "Stwórz";
}

@{
    if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert"> @ViewBag.ErrorMessage</div>
    }
}

<h1>Dodaj wpis o historii szkoły</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TextName" class="control-label"></label>
                <input asp-for="TextName" class="form-control" />
                <span asp-validation-for="TextName" class="text-danger"></span>
            </div>
            <div class="form-group editor-color">
                <label asp-for="Content" class="control-label text-color"></label>
                <textarea id="editor" asp-for="Content" class="form-control"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <hr />
            <div class="form-group">
                <label asp-for="GraphicGalleryFiles" class="control-label">Dodaaj wiele zdjęć do wpisu</label>
                <div class="custom-file">
                    <input asp-for="GraphicGalleryFiles" class="custom-file-input" id="customFile" accept=".jpg,.gif,.png">
                    <label class="custom-file-label" for="customFile">Wybierz pliki</label>
                </div>
                <span asp-validation-for="GraphicGalleryFiles" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Dodaj" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-light">Powrót do historii</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
     <script src="~/lib/ckeditor5/ckeditor.min.js"></script>
    <script src="~/lib/ckeditor5/translations/pl.min.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'),{
                language: 'pl'
            })
            .catch(error => {
                console.error(error);
            })
    </script>
}
