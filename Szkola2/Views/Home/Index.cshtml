@model IEnumerable<Szkola2.Models.Text>
@{
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
    ViewData["Title"] = "Witamy";
    <div class="row ">
    <div class="col-2">
    </div>
    <div class="col-6 index8-home">

        @foreach (var item in Model)
        {
            <div class="card mt-2 head-color shadow-sm">
                <div class="card-header">
                    <h3 class="text-primary roboto">@item.TextName</h3>
                </div>
                <div class="row bg-color">
                    <div class="col-md-4">    
                        <img src="@Url.Content(item.MainGraphic == null ? "~/img/mini/brak.jpg" : "~/img/mini/"+item.MainGraphic)" class="img-fluid" />
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <p class="card-title text-success roboto">Autor: @Html.DisplayFor(modelItem => item.User.FirstName) @Html.DisplayFor(modelItem => item.User.LastName)
                            </p>
                            <p class="card-title text-success roboto">Kategoria: @Html.DisplayFor(modelItem => item.Category.CategoryName)</p>
                            @if (item.Content.Length <= 100)
                            {
                                <p class="card-text roboto">@Html.Raw(item.Content)</p>
                            }
                            else
                            {
                                <p class="card-text roboto">@Html.Raw(item.Content.Substring(0, 100) + "...")</p>
                            }
                            <p class="card-text"><small class="text-muted">@item.DateAdded</small></p>
                            <div class="position-relative">
                                <a href="@Url.Action("Details", "Texts", new{id = item.TextId})" class="btn btn-outline-logoyellow position-absolute bottom-0 end-0" title="Czytaj " >Czytaj >>> </a>
                                
                            </div>
                            
                        </div> <!-- card body-->
                    </div>
                </div> <!-- row -->

            </div> <!-- card-->

        }
        
    <div>
    </div>
    </div>

    <div class="col-4 index4-home">
        <div class="layout_info">
            <h3 id="current-date-time" class="text-center">Aktualna data i godzina</h3>
            <div class="clock-container">
                <div class="clock" id="clock">
                    <div class="hour-hand"></div>
                    <div class="minute-hand"></div>
                    <div class="second-hand"></div>
                </div>
                <div class="calendar">
                    <table id="calendar" class="calendar_table">
                        <thead>
                            <tr>
                                <th class="calendar_th">Pon</th>
                                <th class="calendar_th">Wt</th>
                                <th class="calendar_th">Śr</th>
                                <th class="calendar_th">Czw</th>
                                <th class="calendar_th">Pt</th>
                                <th class="calendar_th">Sob</th>
                                <th class="calendar_th">Ndz</th>
                            </tr>
                        </thead>
                        <tbody>
        
                        </tbody>
                    </table>
                </div>
            </div>   
        </div>

        <div class="layout_info text-center">
            <h3>Biuletyn Informacji Publicznej</h3>
            <div>
                
                <img src="/img/logo/bip.png" class="bip" title="Czytaj " alt="bip" onclick="window.location.href = `https://www.bip.gov.pl/subjects/31747,Szko%C5%82a+Podstawowa+im.+Polskich+Noblist%C3%B3w+w+Goleszynie.html`;" target="_blank" />
               
            </div>
        </div>
        <div class="layout_info text-center">
            <h3>Programy i projekty z których korzystała szkoła</h3>
            <div>
                
                <img src="/img/logo/erazmus.jpg" class="erazmus" title="Czytaj " alt="erazmus+" onclick="window.location.href = `https://www.bip.gov.pl/subjects/31747,Szko%C5%82a+Podstawowa+im.+Polskich+Noblist%C3%B3w+w+Goleszynie.html`;" target="_blank" />
                <img src="/img/logo/aktywna_tablica.jpg" class="inne" title="Czytaj " alt="aktywna_tablica" onclick="window.location.href = `https://www.bip.gov.pl/subjects/31747,Szko%C5%82a+Podstawowa+im.+Polskich+Noblist%C3%B3w+w+Goleszynie.html`;" target="_blank" />
                <img src="/img/logo/eTwinning.png" class="inne" title="Czytaj " alt="eTwinning" onclick="window.location.href = `https://www.bip.gov.pl/subjects/31747,Szko%C5%82a+Podstawowa+im.+Polskich+Noblist%C3%B3w+w+Goleszynie.html`;" target="_blank" />
                <img src="/img/logo/kulturalna.png" class="inne" title="Czytaj " alt="kulturalna szkoła" onclick="window.location.href = `https://www.bip.gov.pl/subjects/31747,Szko%C5%82a+Podstawowa+im.+Polskich+Noblist%C3%B3w+w+Goleszynie.html`;" target="_blank" />
                <img src="/img/logo/lepsza_szkoła.png" class="inne" title="Czytaj " alt="lepsza_szkoła" onclick="window.location.href = `https://www.bip.gov.pl/subjects/31747,Szko%C5%82a+Podstawowa+im.+Polskich+Noblist%C3%B3w+w+Goleszynie.html`;" target="_blank" />
                <img src="/img/logo/labolatoria.jpg" class="inne" title="Czytaj " alt="labolatoria przyszłości" onclick="window.location.href = `https://www.bip.gov.pl/subjects/31747,Szko%C5%82a+Podstawowa+im.+Polskich+Noblist%C3%B3w+w+Goleszynie.html`;" target="_blank" />
                
                
               
            </div>
        </div>
    </div>
    </div>
}
@section Scripts{
    <script src="/js/Day.js"></script>
    <script src="/js/Clock.js"> </script> 
}

