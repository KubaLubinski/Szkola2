@{
    ViewData["Title"] = "Zapraszamy do kontaktu";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">KONTAKT</span>
            <h1>Zapraszamy <span>do kontaktu</span></h1>
        </div>
    </div>

    <!-- Godziny i adres -->
    <div class="contact-info-grid">
        <div class="panel-card contact-info">
            <span class="contact-info-icon" aria-hidden="true"><i class="bi bi-clock-fill"></i></span>
            <div>
                <span class="contact-info-label">Godziny pracy w roku szkolnym</span>
                <strong>7.00 – 15.00</strong>
            </div>
        </div>

        <div class="panel-card contact-info">
            <span class="contact-info-icon" aria-hidden="true"><i class="bi bi-geo-alt-fill"></i></span>
            <div>
                <span class="contact-info-label">Adres</span>
                <strong>ul. Słoneczna 12, 00-000 Przykładowo</strong>
            </div>
        </div>
    </div>

    <!-- Karty kontaktowe -->
    <div class="contact-grid">

        <article class="panel-card contact-card">
            <h2 class="contact-card-title">Dyrektor</h2>
            <ul class="contact-list">
                <li><i class="bi bi-person-circle" aria-hidden="true"></i> <span>Mgr Anna Wiśniewska</span></li>
                <li><i class="bi bi-telephone-fill" aria-hidden="true"></i> <a href="tel:+48225550101">tel. (22) 555-01-01</a></li>
                <li><i class="bi bi-envelope-fill" aria-hidden="true"></i> <a href="mailto:dyrektor@sp-przykladowo.example">dyrektor@sp.example</a></li>
            </ul>
        </article>

        <article class="panel-card contact-card">
            <h2 class="contact-card-title">Sekretariat</h2>
            <ul class="contact-list">
                <li><i class="bi bi-person-circle" aria-hidden="true"></i> <span>Barbara Nowicka</span></li>
                <li><i class="bi bi-telephone-fill" aria-hidden="true"></i> <a href="tel:+48225550102">tel. (22) 555-01-02</a></li>
                <li><i class="bi bi-envelope-fill" aria-hidden="true"></i> <a href="mailto:sekretariat@sp-przykladowo.example">sekretariat@spo.example</a></li>
                <li><i class="bi bi-printer-fill" aria-hidden="true"></i> <span>Fax (22) 555-01-04</span></li>
            </ul>
        </article>

        <article class="panel-card contact-card">
            <h2 class="contact-card-title">Pokój nauczycielski</h2>
            <ul class="contact-list">
                <li><i class="bi bi-person-circle" aria-hidden="true"></i> <span>Kadra nauczycielska</span></li>
                <li><i class="bi bi-telephone-fill" aria-hidden="true"></i> <a href="tel:+48225550103">tel. (22) 555-01-03</a></li>
                <li><i class="bi bi-envelope-fill" aria-hidden="true"></i> <a href="mailto:nauczyciele@sp-przykladowo.example">nauczyciele@sp.example</a></li>
                <li><i class="bi bi-printer-fill" aria-hidden="true"></i> <span>Fax (22) 555-01-04</span></li>
            </ul>
        </article>

    </div>

    <!-- Mapa -->
    <div class="map-frame">
        <iframe title="Mapa dojazdu do Szkoły Podstawowej"
                src="https://www.google.com/maps?q=52.2297,21.0122&z=14&output=embed"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>

</div>
