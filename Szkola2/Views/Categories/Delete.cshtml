@model Szkola2.Models.Category

@{
    ViewData["Title"] = "Usuń kategorię";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg label-danger">UWAGA</span>
            <h1>Usuwanie <span class="heading-danger">kategorii</span></h1>
        </div>
    </div>

    <div class="panel-card panel-narrow panel-danger">

        @if (!String.IsNullOrEmpty(ViewBag.DeleteMessage))
        {
            <div class="alert alert-info" role="alert">
                <i class="bi-info-circle"></i>&nbsp; @ViewBag.DeleteMessage
            </div>
        }
        else
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi-exclamation-triangle"></i>&nbsp; Czy na pewno chcesz usunąć kategorię?
            </div>
        }

        <dl class="detail-list">
            <dt>@Html.DisplayNameFor(model => model.CategoryName)</dt>
            <dd>@Html.DisplayFor(model => model.CategoryName)</dd>

            <dt>@Html.DisplayNameFor(model => model.Description)</dt>
            <dd>@Html.DisplayFor(model => model.Description)</dd>

            <dt>@Html.DisplayNameFor(model => model.IsActive)</dt>
            <dd>@(Model.IsActive == true ? "Tak" : "Nie")</dd>
        </dl>

        <form asp-action="Delete">
            <div class="form-actions">
                @if (String.IsNullOrEmpty(ViewBag.DeleteMessage))
                {
                    <input type="hidden" asp-for="CategoryId" />
                    <button type="submit" class="btn btn-school-danger">Usuń</button>
                }
                <a asp-action="Index" class="btn btn-school-outline">Powrót</a>
            </div>
        </form>

    </div>

</div>
