@model IEnumerable<Szkola2.Models.Category>

@{
    ViewData["Title"] = "Spis kategorii";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">ZARZĄDZANIE</span>
            <h1>Spis <span>kategorii</span></h1>
        </div>

        <a asp-action="Create" title="Utwórz nową kategorię" class="btn btn-school">
            Utwórz nową kategorię <span aria-hidden="true">+</span>
        </a>
    </div>

    <div class="panel-card">
        <div class="table-responsive">
            <table class="table texts-table align-middle">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.CategoryName)</th>
                        <th>@Html.DisplayNameFor(model => model.Description)</th>
                        <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                        <th><span class="visually-hidden">Akcje</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.CategoryName</td>
                            <td class="table-excerpt">@item.Description</td>
                            <td>
                                @if (item.IsActive == true)
                                {
                                    <span class="status-pill status-on">Aktywna</span>
                                }
                                else
                                {
                                    <span class="status-pill status-off">Ukryta</span>
                                }
                            </td>
                            <td class="list-actions">
                                <a asp-action="Edit" asp-route-id="@item.CategoryId" title="Edycja" aria-label="Edycja"
                                   class="btn btn-outline-primary rounded-circle bi-pencil-fill"></a>
                                <a asp-action="Details" asp-route-id="@item.CategoryId" title="Szczegóły" aria-label="Szczegóły"
                                   class="btn btn-outline-success rounded-circle bi-eye"></a>
                                <a asp-action="Delete" asp-route-id="@item.CategoryId" title="Usuwanie" aria-label="Usuwanie"
                                   class="btn btn-outline-danger rounded-circle bi-trash-fill"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>