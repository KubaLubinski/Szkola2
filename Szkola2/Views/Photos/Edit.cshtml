@model Szkola2.Models.Photo

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Photo</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PhotoId" />
            <div class="form-group">
                <label asp-for="Graphic" class="control-label"></label>
                <input asp-for="Graphic" class="form-control" />
                <span asp-validation-for="Graphic" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TextId" class="control-label"></label>
                <select asp-for="TextId" class="form-control" asp-items="ViewBag.TextId"></select>
                <span asp-validation-for="TextId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HistoryId" class="control-label"></label>
                <input asp-for="HistoryId" class="form-control" />
                <span asp-validation-for="HistoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
