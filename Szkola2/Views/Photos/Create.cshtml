@model Szkola2.Models.Photo

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Photo</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Graphic" class="control-label"></label>
                <input type="file" multiple name="picture" id="picture" class="form-control" accept=".jpg,.gif,.png" />
                <span asp-validation-for="Graphic" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TextId" class="control-label"></label>
                <input asp-for="TextId" class ="form-control"/>
            </div>
            <div class="form-group">
                <label asp-for="HistoryId" class="control-label"></label>
                <input asp-for="HistoryId" class="form-control" />
                <span asp-validation-for="HistoryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
