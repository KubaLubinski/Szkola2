@model Szkola2.Models.Text

@{
    ViewData["Title"] = "Dodawanie teksu";
}

<h1 class="text-primary roboto">Dodaj Nowy Wpis o Wydarzeniach z Życia Szkoły </h1>

@{
    if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert"> @ViewBag.ErrorMessage</div>
    }
}
<hr />
<div class="row">
    <div class="col-md-8 interspace">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TextName" class="control-label"></label>
                <input asp-for="TextName" class="form-control" />
                <span asp-validation-for="TextName" class="text-danger"></span>
            </div>
            <div class="form-group editor-color">
                <label asp-for="Content" class="control-label text-color"></label>
                <textarea id="editor" asp-for="Content" class="form-control"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MainGraphic" class="control-label"></label>
                <input type="file" name="picture" id="picture" class="form-control" accept=".jpg,.gif,.png" />
                <span asp-validation-for="MainGraphic" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GraphicGalleryFiles" class="control-label">Dodaj wiele zdjęć do wpisu</label>
                <div class="custom-file">
                    <input asp-for="GraphicGalleryFiles" class="custom-file-input" id="customFile" accept=".jpg,.gif,.png">
                    <label class="custom-file-label" for="customFile">Wybierz pliki </label>
                </div>
                <span asp-validation-for="GraphicGalleryFiles" class="text-danger"></span>
            </div>
            <hr />
            <div class="form-group">
                <label asp-for="CategoryId" class="control-label"></label>
                <select asp-for="CategoryId" class ="form-control" asp-items="ViewBag.CategoryId">
                <option value="">-- Wybierz kategorię --</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="EventDate" class="control-label"></label>
                <input asp-for="EventDate" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>
            
            <div class="form-group">
                <hr />
                <input type="submit" value="Dodaj" class="btn btn-primary" /> | 
                <a asp-action="Index" class="btn btn-light">Powrót do listy</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/eventDateVisibility.js"></script>
    <script src="~/lib/ckeditor5/ckeditor.min.js"></script>
    <script src="~/lib/ckeditor5/translations/pl.min.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'),{
                language: 'pl'
            })
            .catch(error => {
                console.error(error);
            })
    </script>
}
