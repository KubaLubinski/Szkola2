@model Szkola2.Models.Text

@{
    ViewData["Title"] = "Usuwanie";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg label-danger">UWAGA</span>
            <h1>Usuwanie <span class="heading-danger">tekstu</span></h1>
        </div>
    </div>

    <div class="panel-card panel-narrow panel-danger">

        <p class="delete-question">Czy na pewno chcesz usunąć ten tekst? Tej operacji nie można cofnąć.</p>

        <div class="delete-summary">
            <img src="@Url.Content(Model.MainGraphic == null ? "~/img/mini/brak.jpg" : "~/img/mini/" + Model.MainGraphic)"
                 class="delete-photo"
                 alt="@Model.TextName" />

            <dl class="detail-list">
                <dt>@Html.DisplayNameFor(model => model.TextName)</dt>
                <dd>@Html.DisplayFor(model => model.TextName)</dd>

                <dt>@Html.DisplayNameFor(model => model.DateAdded)</dt>
                <dd>@Model.DateAdded.ToString("dd.MM.yyyy")</dd>

                <dt>Kategoria</dt>
                <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>

                <dt>Autor</dt>
                <dd>@Html.DisplayFor(model => model.User.FullName)</dd>

                <dt>@Html.DisplayNameFor(model => model.IsActive)</dt>
                <dd>@(Model.IsActive == true ? "Tak" : "Nie")</dd>
            </dl>
        </div>

        <h2 class="form-section-title">@Html.DisplayNameFor(model => model.Content)</h2>
        <div class="detail-content delete-content">
            @Html.Raw(Model.Content)
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="TextId" />
            <div class="form-actions">
                <button type="submit" class="btn btn-school-danger">Usuń</button>
                <a asp-action="Index" class="btn btn-school-outline">Powrót do listy</a>
            </div>
        </form>

    </div>

</div>

