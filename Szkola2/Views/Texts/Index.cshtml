@using Szkola2.Infrastructure
@model TextsViewModel
@{
    ViewData["Title"] = "Lista tekstów";
}

<div class="school-home">

    <!-- Nagłówek -->
    <div class="section-heading">
        <div>
            <span class="section-label section-label-lg">CO SŁYCHAĆ?</span>
            <h2>Wszystkie <span>aktualności</span></h2>
        </div>
    </div>

    <div class="texts-layout">

        <!-- Wyszukiwarka -->
        <aside class="texts-filter info-card">
            <div class="info-card-header">
                <div>
                    <span class="section-label">FILTRY</span>
                    <h3>Szukaj tekstu</h3>
                </div>
            </div>

            @using (Html.BeginForm("Index", "Texts", new { PageNumber = "1" }, FormMethod.Get))
            {
                <div class="texts-filter-field">
                    <label for="Kategoria" class="form-label fw-bold small">Kategoria</label>
                    @Html.DropDownList("Kategoria", ViewBag.Category, "--- Wszystkie ---", htmlAttributes: new { @class = "form-select" })
                </div>

                <div class="texts-filter-field">
                    <label for="Fraza" class="form-label fw-bold small">Fragment tekstu</label>
                    <input type="text" class="form-control" id="Fraza" name="Fraza" placeholder="Szukany ciąg" value="@Model.TextsView?.Pharse">
                </div>

                <button type="submit" class="primary-outline-button texts-filter-button">
                    Filtruj <span>→</span>
                </button>
            }
        </aside>

        <!-- Lista tekstów -->
        <div class="texts-list">
            @if (Model.TextsView.TextCount > 0)
            {
                @foreach (var item in Model.Texts)
                {
                    <article class="news-card news-card-row">
                        <div class="news-image-wrapper">
                            <img src="@Url.Content(item.MainGraphic == null ? "~/img/mini/brak.jpg" : "~/img/mini/" + item.MainGraphic)"
                                 class="news-image"
                                 alt="@item.TextName">

                            @if (item.Category != null)
                            {
                                <div class="news-category">@item.Category.CategoryName</div>
                            }
                        </div>

                        <div class="news-body">
                            <div class="news-date">@item.DateAdded.ToString("dd.MM.yyyy")</div>

                            <h3>@item.TextName</h3>

                            <div class="news-author">
                                <span class="author-avatar">@(string.IsNullOrEmpty(item.User?.FirstName) ? "?" : item.User.FirstName[..1])</span>
                                <span>@item.User?.FullName</span>
                            </div>

                            <div class="news-description">
                                @TextPreview.FromHtml(item.Content, 220)
                            </div>

                            <a href="@Url.Action("Details", "Texts", new { id = item.TextId })" class="read-more">
                                Czytaj więcej <span>→</span>
                            </a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="texts-empty info-card" role="alert">
                    <span class="texts-empty-icon" aria-hidden="true">ℹ</span>
                    <div>Brak tekstów do wyświetlenia. Proszę zmienić parametry filtrowania lub szukany ciąg.</div>
                </div>
            }
        </div>
    </div>

    <!-- Stronicowanie -->
    <nav aria-label="Nawigacja między stronami">
        <ul class="pagination justify-content-center texts-pagination">
            @if (Model.TextsView.PageNumber > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", "Texts", new { PageNumber = Model.TextsView.PageNumber - 1, Kategoria = Model.TextsView.Category, Fraza = Model.TextsView.Pharse })">Poprzednia</a>
                </li>
            }

            @for (var i = 1; i < Model.TextsView.PageCount + 1; i++)
            {
                <li class="page-item @(i == Model.TextsView.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", "Texts", new { PageNumber = i, Kategoria = Model.TextsView.Category, Fraza = Model.TextsView.Pharse })"
                    @(i == Model.TextsView.PageNumber ? Html.Raw("aria-current=\"page\"") : null)>@i</a>
                </li>
            }

            @if (Model.TextsView.PageNumber < Model.TextsView.PageCount)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", "Texts", new { PageNumber = Model.TextsView.PageNumber + 1, Kategoria = Model.TextsView.Category, Fraza = Model.TextsView.Pharse })">Następna</a>
                </li>
            }
        </ul>
    </nav>

</div>

<!-- Animacja kart -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const elements = document.querySelectorAll(".news-card, .info-card, .section-heading");

        if (!("IntersectionObserver" in window)) {
            elements.forEach(el => el.classList.add("animate-in"));
            return;
        }

        const observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add("animate-in");
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });

        elements.forEach(el => observer.observe(el));
    });
</script>
