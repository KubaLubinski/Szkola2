@model TextsViewModel
@{
    ViewData["Title"] = "Lista tekstów";
}

<div class="container ">
    <div class="row text-color">
        <!-- wyszukiwarka-->
        <div class="d-none d-md-block col-md-12 col-xl-3">
            <div class="card mt-2 shadow-sm ">
                <div class="card-body bg-color">
                    @using (Html.BeginForm("Index","Texts", new { PageNumber = "1" }, FormMethod.Get))
                    {
                    <div class="row gt-3">
                        <div class="form-group col-auto">
                            <label for="Kategoria">Kategoria</label>
                           @Html.DropDownList("Kategoria" , ViewBag.Category, "--- Wszystkie ---", htmlAttributes:new{ @class = "form-control"})
                        </div>   
                        <div class="form-group col-auto">
                            <label for="Fraza">Fragment tekstu</label>
                           <input type="text" class="form-control" id="Fraza" name="Fraza" placeholder="Szukany ciąg" value="@Model.TextsView?.Pharse">
                        </div>
                        <button type="submit"class="btn btn-primary mt-4 col-auto">Filtruj</button>
                    </div>
                    }
                </div>
            </div>
        </div>
        <!-- L tekstow-->
        
        <div class="col-xl-9">
        @if (Model.TextsView.TextCount > 0)
        {
            @foreach (var item in Model.Texts)
            {
                <div class="card mt-2 head-color shadow-sm ">
                    <div class="card-header">
                        <h4 class="text-primary oswald">@item.TextName</h4>
                    </div>
                    <div class="row bg-color">
                        <div class="col-md-4">    
                            <img src="@Url.Content(item.MainGraphic == null ? "~/img/mini/brak.jpg" : "~/img/mini/"+item.MainGraphic)" class="img-fluid" />
                        </div>
                        <div class="col-md-8">
                            <div class="card-body">
                                <h5 class="card-title text-success">@item.User.FullName</h5>
                                @if (item.Content.Length <= 100)
                                {
                                    <p class="card-text fst-italic">@Html.Raw(item.Content)</p>
                                }
                                else
                                {
                                    <p class="card-text fst-italic">@Html.Raw(item.Content.Substring(0, 100) + "...")</p>
                                }
                                <p class="card-text"><small class="text-muted"> @item.DateAdded </small></p>
                                <div class="position-relative">
                                    <a href="@Url.Action("Details", "Texts", new{id = item.TextId})" class="btn btn-outline-primary position-absolute bottom-0 end-0">Czytaj >>></a>
                                </div>
                            </div> <!-- card body-->
                    </div>
                        </div> <!-- row -->
            </div> <!-- card-->
                }
                <!-- petla -->

            } else
            {
                <div class="alert alert-info d-flex align-items-center mt2" role="alert">
                    <i class="bi bi-info-circle-fill me-3"> Brak tekstów do wyświetlenia. Proszę zmienić parametry filtrowania, lub szukanego ciągu.</i>
                </div>
            }
        </div> 
        
         
    </div> <!-- obszar z danymi-->

    <!-- stronnicowanie -->
    <div class ="row mt-3">
        <navi aria-label="Nawigacja między stronami">
            <ul class="pagination">
            @{
                if (Model.TextsView.PageNumber > 1)
                {

                        <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", "Texts", new{PageNumber =Model.TextsView.PageNumber -1, Kategoria = Model.TextsView.Category, Fraza = Model.TextsView.Pharse})">Poprzednia </a>
                        </li>
                    }
               for (var i=1; i<Model.TextsView.PageCount; i++)
                {
                <li class="@(i == @Model.TextsView.PageNumber ? "page-item active" : "pageactive")">
                <a class="page-link" href="@Url.Action("Index", "Texts", new{PageNumber = i, Kategoria = Model.TextsView.Category, Fraza = Model.TextsView.Pharse} )">@i </a>
                </li>
                }
                if(Model.TextsView.PageNumber <Model.TextsView.PageCount)
                {
                <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", "Texts", new{PageNumber =Model.TextsView.PageNumber +1, Kategoria = Model.TextsView.Category, Fraza = Model.TextsView.Pharse})">Następna </a>
                </li>
                }
            }
            </ul>
        </navi>
    </div>

</div>
