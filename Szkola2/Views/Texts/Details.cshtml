@model Szkola2.Models.Text

@{
    ViewData["Title"] = "Szczegóły";
}

<h1  class="text-success roboto">Szczegóły</h1>

<div>
    
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TextName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TextName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Content)
        </dt>
        <dd class = "col-sm-10">
            @Html.Raw(Model.Content)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateAdded)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateAdded)
        </dd>
        <dt class="col-sm-2">
            Galeria zdjęć:
        </dt>
        <dd class="col-sm-10">
            <div id="carouselExample" class="carousel slide">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.GraphicGallery.Count(); i++)
                    {
                        <div class="@(i==0 ? "carousel-item active" : "carousel-item") ">                        
                            <img class="d-block img-fluid mx-auto" src="@Url.Content("~/miniGallery/"+Model.GraphicGallery[i].URL)" alt="@Model.GraphicGallery[i].Name">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev custom-carousel-control" title="Poprzednie " type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next custom-carousel-control" title="Nastepne "type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span> 
                </button>
            </div>
        </dd>
        <dt class = "col-sm-2">
            Kategoria:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Category.CategoryName)
        </dd>
        <dt class = "col-sm-2">
            Autor:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.User.FullName)
        </dd>
    </dl>
</div>
<div>
    <hr/> 
    @{
        if (User.IsInRole("admin") || User.IsInRole("dyrektor") || User.IsInRole("nauczyciel") || User.IsInRole("uczeń"))
        {
            <a asp-action="Edit" asp-route-id="@Model?.TextId" class="btn btn-warning">Edytuj</a>
         
        }
     }
        <a asp-action="Index" class="btn btn-light">Powrót do listy</a>
</div>
