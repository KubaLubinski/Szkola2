@model Szkola2.Models.Text

@{
    ViewData["Title"] = "Szczegóły";
}

<h1>Szczegóły</h1>

<div>
    <h4>Tekst</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TextName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TextName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Content)
        </dt>
        <dd class = "col-sm-10">
            @Html.Raw(Model.Content)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateAdded)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateAdded)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MainGraphic)
        </dt>
        <dd class = "col-sm-10">
            <img src="@Url.Content(Model.MainGraphic == null ? "~/img/mini/brak.jpg" : "~/img/mini/"+Model.MainGraphic)" width="150" alt="@Model.Category.CategoryName">
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.GraphicGallery)
        </dt>
        <dd class="col-sm-10">
            <div id="carouselExample" class="carousel slide">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.GraphicGallery.Count(); i++)
                    {
                        <div class="@(i==0 ? "carousel-item active" : "carousel-item") ">
@*                            <img class="d-block w-100" src="@Model.GraphicGallery[i].URL" alt="@Model.GraphicGallery[i].Name" width="600">*@
                            <img class="d-block w-100" src="@Url.Content("~/miniGallery/"+Model.GraphicGallery[i].URL)" alt="@Model.GraphicGallery[i].Name" width="600">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Category)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Category.CategoryName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.User)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.User.FullName)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.TextId" class="btn btn-warning">Edytuj</a> |
    <a asp-action="Index" class="btn btn-light">Powrót do listy</a>
</div>
