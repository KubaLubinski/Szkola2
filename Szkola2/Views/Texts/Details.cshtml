@model Szkola2.Models.Text

@{
    ViewData["Title"] = "Szczegóły";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">@(Model.Category?.CategoryName?.ToUpper() ?? "SZCZEGÓŁY")</span>
            <h1>@Model.TextName</h1>
        </div>
    </div>

    <article class="panel-card">

        <div class="detail-meta">
            <span class="detail-meta-item">
                <span aria-hidden="true">📅</span>
                @Model.DateAdded.ToString("dd.MM.yyyy")
            </span>

            @if (Model.User != null)
            {
                <span class="detail-meta-item news-author">
                    <span class="author-avatar">@Model.User.FirstName.Substring(0, 1)</span>
                    <span>@Model.User.FullName</span>
                </span>
            }

            @if (Model.Category != null)
            {
                <span class="detail-badge">@Model.Category.CategoryName</span>
            }
        </div>

        <div class="detail-content">
            @Html.Raw(Model.Content)
        </div>

        @if (Model.GraphicGallery.Count() > 0)
        {
            <h2 class="form-section-title mt-4">Galeria zdjęć</h2>

            <div id="carouselExample" class="carousel slide gallery-carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.GraphicGallery.Count(); i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img class="d-block img-fluid mx-auto"
                                 src="@Url.Content("~/miniGallery/" + Model.GraphicGallery[i].URL)"
                                 alt="@($"{Model.TextName} – zdjęcie {i + 1} z {Model.GraphicGallery.Count()}")">
                        </div>
                    }
                </div>

                <button class="carousel-control-prev" title="Poprzednie" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Poprzednie</span>
                </button>
                <button class="carousel-control-next" title="Następne" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Następne</span>
                </button>
            </div>
        }

        <div class="form-actions">
            @if (User.IsInRole("admin") || User.IsInRole("dyrektor") || User.IsInRole("nauczyciel") || User.IsInRole("uczeń"))
            {
                <a asp-action="Edit" asp-route-id="@Model.TextId" class="btn btn-school-warning">Edytuj</a>
            }
            <a asp-action="Index" class="btn btn-school-outline">Powrót do listy</a>
        </div>

    </article>

</div>



