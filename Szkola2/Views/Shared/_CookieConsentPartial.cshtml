@using Microsoft.AspNetCore.Http.Features
@{
    var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    <div id="cookieConsent" class="site-notice site-notice--cookie" role="alert">
        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
        <div class="site-notice__text">
            Ta strona wykorzystuje pliki cookie do działania.
            <a asp-controller="Home" asp-action="Privacy">Dowiedz się więcej</a>
        </div>
        <div class="site-notice__actions">
            <button type="button" class="btn btn-school btn-sm" data-cookie-string="@cookieString">Akceptuję</button>
        </div>
    </div>
    <script>
        (function () {
            var banner = document.getElementById("cookieConsent");
            var button = banner && banner.querySelector("button[data-cookie-string]");
            if (!button) return;
            button.addEventListener("click", function () {
                document.cookie = button.getAttribute("data-cookie-string");
                banner.remove();
            });
        })();
    </script>
}
