<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Szkola2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Szkola2.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header id="header" class="container-fluid back" style="height: 100vh;">
       @*<div class="carousel-inner">
            

        </div> *@
        <div class="row text-center col-10 offset-1 col-lg-8 offset-lg-2">
            <div class="transparency mt-4">
                <h1 class="szkola-title roboto mt-3 text-light">Szkoła podstawowa imienia polskich noblistów w Goleszynie</h1>
                <h4 class="lh-base text-light" >
                    Witamy na stronie udostępniającej państwu informacje z życia szkoły. Zapraszamy. </br>
                    <div>
                    <a href='#navbar' class="btn btn-success rounded-circle roboto mt-3 mb-4"  onclick="scrollToNavbar()"> Przejdz do strony głównej</a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-success rounded-circle roboto mt-3 mb-4">Zaloguj się</a>
                    </div>
                    
                </h4>

            </div>

        </div>
 
    </header>
     <nav id="navbar" class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img src ="~/img/logo/images.png" alt="logo szkoły" height="40"/></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Texts" asp-action="Index">Informacje</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="History" asp-action="Index">Historia szkoły</a>
                        </li>   
                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Documents" asp-action="Index">Dokumenty</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="PastSchoolEvents" asp-action="Index">Z życia szkoły</a>
                        </li>
                        @{
                            @if ((User.IsInRole("admin"))  || (User.IsInRole("dyrektor")) || (User.IsInRole("nauczyciel")) || (User.IsInRole("uczen")))
                            {                     
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Administracja
                            </a>
                            <ul class="dropdown-menu">
                            <li class="nav-item">
                                 <a class="nav-link text-dark" asp-area="" asp-controller="Texts" asp-action="Create">Stwórz tekst</a>
                            </li>                          
                            @if ((User.IsInRole("admin")) || (User.IsInRole("dyrektor")))
                            {
                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>
                                    <li>
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Texts" asp-action="List">Lista tekstów</a>
                                    </li>
                                    <li>
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Categories" asp-action="Index">Kategorie</a>
                                    </li>
                                    <li>
                                        <a class="nav-link text-dark" asp-area="" asp-controller="AdvertisingPhotoes" asp-action="Index">Zdjęcia</a>
                                    </li>
                                    <li>
                                        <a class="nav-link text-dark" asp-area="" asp-controller="PastSchoolEventsContoller" asp-action="Index">Kalendarium wydarzeń</a>
                                    </li>
                            }
                            </ul>
                           
                        </li>
                        }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    <div>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br>ala </br></br>ala </br>ala </br>ala </br>ala </br>ala </br></div>
    <div class="container">
        <partial name="_CookieConsentPartial" />
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2023 - Szkola2 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Polityka prywatności</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
    function scrollToNavbar() {
        var headerOffset = document.getElementById("header").offsetTop;
        window.scroll({
            top: headerOffset,
            left: 0,
            behavior: "smooth"
        });
    }
    </script>   
</body>
</html>
   
