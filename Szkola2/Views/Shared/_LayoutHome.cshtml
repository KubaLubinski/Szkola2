<!DOCTYPE html>
<html lang="pl">
<head>
    <script>
            /* Zapobiega białemu błyskowi: ciemne tło ustawiane zanim strona się narysuje */
            (function () {
                try {
                    var dark = localStorage.getItem("darkMode") === "true";
                    if (dark) document.documentElement.classList.add('dark-pre');
                    /* rozmiar tekstu (zapisywany przez Font-size.js) przywracany od razu, żeby strona nie "skakała" po załadowaniu */
                    var fs = parseInt(localStorage.getItem("siteFontScale"), 10);
                    if (fs >= 80 && fs <= 150) document.documentElement.style.fontSize = fs + "%";
                } catch (e) { }
            })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Szkola2</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Strona Szkoły Podstawowej im. Polskich Noblistów w Goleszynie: aktualności, wydarzenia, historia szkoły, dokumenty i kontakt.")" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- style spoza strony (toastr, ikony) ładowane bez blokowania pierwszego wyrenderowania -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Szkola2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" media="print" onload="this.media='all'">
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    </noscript>
</head>
<body>
    <a class="skip-link" href="#@(ViewData["SkipTarget"] ?? "main-content")">Przejdź do treści</a>
    <script>
        /* tryb ciemny: klasa na <body> od razu, zanim strona się narysuje (Light-darkmode.js dopiero na końcu strony) */
        if (document.documentElement.classList.contains('dark-pre')) document.body.classList.add('dark-theme');
    </script>
    <!-- PASEK NAWIGACJI (Stały kolor, bez przezroczystości, wyróżniony) -->
    <nav id="navbar" class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3 sticky-top" style="background-color: #f1f3f5; z-index: 1030;">
        <div class="container-fluid px-3">

            <!-- LOGO -->
            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo/logo_szkoly.png" alt="Logo Szkoły Podstawowej" height="40" />
            </a>

            <!-- PRZYCISK MOBILNY -->
            <button class="navbar-toggler height" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Przełącz nawigację">
                <span class="bi bi-stack"></span>
            </button>

            <!-- ELEMENTY MENU -->
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">

                <ul class="navbar-nav flex-grow-1 align-items-sm-center">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Texts" asp-action="Index">Aktualności</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="History" asp-action="list">Historia</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Documents" asp-action="Index">Dokumenty</a>
                    </li>

                    <!-- KALENDARIUM -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Kalendarium
                        </a>
                        <ul class="dropdown-menu dropdown-color shadow-sm border-0 bg-white">
                            @{
                                int currentYear = DateTime.Now.Year;
                                for (int year = currentYear; year >= currentYear - 3; year--)
                                {
                                    int yearm = year + 1;
                                    <li class="nav-item">
                                        <a class="dropdown-item text-dark" asp-area="" asp-controller="PastSchoolEvents" asp-action="yearEvents" asp-route-year="@year">Rok szkolny @year/@yearm</a>
                                    </li>
                                }
                            }
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Contact">Kontakt</a>
                    </li>

                    <!-- ADMINISTRACJA -->
                    @if ((User.IsInRole("admin")) || (User.IsInRole("dyrektor")) || (User.IsInRole("nauczyciel")) || (User.IsInRole("uczen")))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Administracja
                            </a>
                            <ul class="dropdown-menu dropdown-color shadow-sm border-0 bg-white">
                                <li class="nav-item">
                                    <a class="dropdown-item text-dark" asp-area="" asp-controller="Texts" asp-action="Create">Dodaj wpis o wydarzeniach</a>
                                </li>
                                @if ((User.IsInRole("admin")) || (User.IsInRole("dyrektor")))
                                {
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="Texts" asp-action="List">Lista tekstów</a></li>
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="Categories" asp-action="Index">Kategorie</a></li>
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="AdvertisingPhotoes" asp-action="Index">Zdjęcia</a></li>
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="Documents" asp-action="Index">Lista dokumentów</a></li>
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="History" asp-action="Index">Historia szkoły</a></li>
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="PastSchoolEvents" asp-action="Index">Kalendarium wydarzeń</a></li>
                                }
                                @if (User.IsInRole("admin"))
                                {
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="Users" asp-action="UsersList">Zarządzaj użytkownikami</a></li>
                                }
                            </ul>
                        </li>
                    }
                </ul>

                <!-- NARZĘDZIA DOSTĘPNOŚCI -->
                <div class="nav-tools">
                    <button type="button" class="transparent-button" title="Powiększ rozmiar tekstu" onclick="increaseFontSize()">
                        <span class="bi bi-zoom-in"></span>
                        <span class="visually-hidden">Powiększ tekst</span>
                    </button>
                    <button type="button" class="transparent-button" title="Zmniejsz rozmiar tekstu" onclick="decreaseFontSize()">
                        <span class="bi bi-zoom-out"></span>
                        <span class="visually-hidden">Zmniejsz tekst</span>
                    </button>
                    <button type="button"
                            class="transparent-button"
                            title="Przełącz tryb kolorów">
                        <i class="bi bi-brightness-high icon-size" id="ldmode"></i>
                        <span class="visually-hidden">Przełącz tryb kolorów</span>
                    </button>
                </div>

                <!-- CZĘŚĆ LOGOWANIA -->
                <div class="ms-sm-2 nav-login">
                    <partial name="_LoginPartial" />
                </div>

            </div>
        </div>
    </nav>

    <!-- TREŚĆ GŁÓWNA STRONY -->
    <div class="container my-4 page-content">

        <partial name="_CookieConsentPartial" />
        <partial name="_DemoBanner" />
        <main role="main" id="main-content" tabindex="-1" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- STOPKA -->
    <footer class="footer site-footer border-top text-muted">
        <div class="container site-footer-inner">
            <div class="site-footer-copy">
                &copy; 2026 - Szkoła Podstawowa im. Polskich Noblistów w Goleszynie
            </div>
            <nav class="site-footer-links" aria-label="Linki w stopce">
                <a asp-area="" asp-controller="Home" asp-action="Contact"><i class="bi bi-envelope-fill" aria-hidden="true"></i> Kontakt</a>
                <a href="https://www.facebook.com/p/Szko%C5%82a-Podstawowa-im-Polskich-Noblist%C3%B3w-w-Goleszynie-100063569227821/?_rdr" target="_blank" rel="noopener noreferrer"><i class="bi bi-facebook" aria-hidden="true"></i> Facebook</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Polityka prywatności</a>
                <a asp-area="" asp-controller="Home" asp-action="Accessibility"><i class="bi bi-universal-access" aria-hidden="true"></i> Deklaracja dostępności</a>
            </nav>
            <button type="button" class="back-to-top" id="backToTop" aria-label="Przewiń na górę strony" title="Na górę">
                <i class="bi bi-arrow-up" aria-hidden="true"></i><span>Na górę</span>
            </button>
        </div>
    </footer>

    <!-- SKRYPTY -->
    <script src="/js/Day.js" asp-append-version="true"></script>
    <script src="/js/Clock.js" asp-append-version="true"></script>
    <script src="/js/Light-darkmode.js" asp-append-version="true"></script>
    <script src="/js/Font-size.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    <script src="/js/navbar-fit.js" asp-append-version="true"></script>
    <script>
    /* Animacja pojawiania się elementów na podstronach (jak na stronie głównej).
       Dodaje .reveal wybranym blokom, a .animate-in gdy wjadą w widok. */
    (function () {
        var SELECTORS = [
            ".page-heading", ".panel-card",
            ".contact-info", ".contact-card",
            ".doc-card", ".photo-card",
            ".history-entry", ".event-card"
        ].join(", ");

        // elementy, które mają już własną animację ze strony głównej / listy aktualności
        var SKIP = ".info-card, .news-card, .quick-card, .section-heading";

        function init() {
            if (!("IntersectionObserver" in window)) return;
            if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

            var items = Array.prototype.filter.call(document.querySelectorAll(SELECTORS), function (el) {
                return !el.matches(SKIP) && !el.closest(SKIP);
            });
            if (!items.length) return;

            // kolejne rodzeństwo pojawia się z lekkim opóźnieniem (max 6 kroków)
            var perParent = new Map();
            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (!entry.isIntersecting) return;
                    var el = entry.target;
                    el.classList.add("animate-in");
                    observer.unobserve(el);
                    el.addEventListener("transitionend", function done(e) {
                        if (e.target !== el) return;
                        el.style.transitionDelay = "";
                        el.removeEventListener("transitionend", done);
                    });
                });
            }, { threshold: 0, rootMargin: "0px 0px -6% 0px" });

            items.forEach(function (el) {
                var n = perParent.get(el.parentNode) || 0;
                perParent.set(el.parentNode, n + 1);
                if (n > 0) el.style.transitionDelay = Math.min(n, 6) * 70 + "ms";
                el.classList.add("reveal");
                observer.observe(el);
            });
        }

        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
        else init();
    })();
    </script>
    <script src="/js/back-to-top.js" asp-append-version="true"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            function scrollToNavbar(event) {
                if (event) event.preventDefault();
                var navbarElement = document.getElementById("navbar");
                if (navbarElement) {
                    var navbarOffset = navbarElement.offsetTop;
                    window.scroll({
                        top: navbarOffset,
                        left: 0,
                        behavior: "smooth"
                    });
                }
            }
    </script>
</body>
</html>
