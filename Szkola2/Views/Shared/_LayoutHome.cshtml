<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Szkola2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Szkola2.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <!-- PEŁNOEKRANOWA SEKCJA POWITALNA (HERO) -->
    <header id="header" class="container-fluid back d-flex align-items-center justify-content-center" style="height: 100vh;">
        <div class="row text-center col-10 offset-1 col-lg-8 offset-lg-2">
            <div class="transparency p-4 rounded-4">
                <h1 class="szkola-title roboto mt-3 text-light fw-bold">Szkoła Podstawowa imienia Polskich Noblistów w Goleszynie</h1>
                <p class="lh-base text-light fs-5 my-3">
                    Witamy na stronie udostępniającej Państwu informacje z życia szkoły. Zapraszamy do zapoznania się z aktualnościami.
                </p>
                <div>
                    <a href="#navbar" class="btn btn-dark roboto mt-3 mb-4 px-4 py-2 fw-semibold shadow-sm" onclick="scrollToNavbar(event)">
                        Przejdź do strony głównej ↓
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- PASEK NAWIGACJI (Stały kolor, bez przezroczystości, wyróżniony) -->
    <nav id="navbar" class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3 sticky-top" style="background-color: #f1f3f5; z-index: 1030;">
        <div class="container-fluid px-3">

            <!-- LOGO -->
            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo/images.png" alt="Logo Szkoły Podstawowej w Goleszynie" height="40" />
            </a>

            <!-- PRZYCISK MOBILNY -->
            <button class="navbar-toggler height" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Przełącz nawigację">
                <span class="bi bi-stack"></span>
            </button>

            <!-- ELEMENTY MENU -->
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">

                <ul class="navbar-nav flex-grow-1 align-items-sm-center">
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Texts" asp-action="Index">Aktualności</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="History" asp-action="list">Historia</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Documents" asp-action="Index">Dokumenty</a>
                    </li>

                    <!-- KALENDARIUM -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Kalendarium
                        </a>
                        <ul class="dropdown-menu dropdown-color shadow-sm border-0 bg-white">
                            @{
                                int currentYear = DateTime.Now.Year;
                                for (int year = currentYear - 3; year <= currentYear; year++)
                                {
                                    int yearm = year + 1;
                                    <li class="nav-item">
                                        <a class="dropdown-item text-dark" asp-area="" asp-controller="PastSchoolEvents" asp-action="yearEvents" asp-route-year="@year">Rok szkolny @year/@yearm</a>
                                    </li>
                                }
                            }
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Contact">Kontakt</a>
                    </li>

                    <!-- ADMINISTRACJA -->
                    @if ((User.IsInRole("admin")) || (User.IsInRole("dyrektor")) || (User.IsInRole("nauczyciel")) || (User.IsInRole("uczen")))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Administracja
                            </a>
                            <ul class="dropdown-menu dropdown-color shadow-sm border-0 bg-white">
                                <li class="nav-item">
                                    <a class="dropdown-item text-dark" asp-area="" asp-controller="Texts" asp-action="Create">Dodaj wpis o wydarzeniach</a>
                                </li>
                                @if ((User.IsInRole("admin")) || (User.IsInRole("dyrektor")))
                                {
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="Texts" asp-action="List">Lista tekstów</a></li>
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="Categories" asp-action="Index">Kategorie</a></li>
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="AdvertisingPhotoes" asp-action="Index">Zdjęcia</a></li>
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="Documents" asp-action="Index">Lista dokumentów</a></li>
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="History" asp-action="Index">Historia szkoły</a></li>
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="PastSchoolEvents" asp-action="Index">Kalendarium wydarzeń</a></li>
                                }
                                @if (User.IsInRole("admin"))
                                {
                                    <li><a class="dropdown-item text-dark" asp-area="" asp-controller="Users" asp-action="UsersList">Zarządzaj użytkownikami</a></li>
                                }
                            </ul>
                        </li>
                    }
                </ul>

                <!-- NARZĘDZIA DOSTĘPNOŚCI -->
                <div class="d-flex align-items-center gap-2 my-2 my-sm-0 me-3">
                    <button class="transparent-button" title="Powiększ rozmiar tekstu" onclick="increaseFontSize()">
                        <span class="bi bi-zoom-in"></span>
                        <span class="visually-hidden">Powiększ tekst</span>
                    </button>
                    <button class="transparent-button" title="Zmniejsz rozmiar tekstu" onclick="decreaseFontSize()">
                        <span class="bi bi-zoom-out"></span>
                        <span class="visually-hidden">Zmniejsz tekst</span>
                    </button>
                    <button class="transparent-button border-0 bg-transparent p-0" title="Przełącz tryb kolorów">
                        <i class="bi bi-brightness-high" id="ldmode" style="font-size: 1.2rem; cursor: pointer;"></i>
                        <span class="visually-hidden">Przełącz kontrast i kolory</span>
                    </button>
                </div>

                <!-- CZĘŚĆ LOGOWANIA -->
                <div class="ms-sm-2">
                    <partial name="_LoginPartial" />
                </div>

            </div>
        </div>
    </nav>

    <!-- TREŚĆ GŁÓWNA STRONY -->
    <div class="container my-4">
        <partial name="_CookieConsentPartial" />
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- STOPKA -->
    <footer class="border-top footer text-muted py-4 mt-auto bg-light">
        <div class="container text-center text-sm-start">
            &copy; 2026 - Szkoła Podstawowa im. Polskich Noblistów w Goleszynie - <a asp-area="" asp-controller="Home" asp-action="Privacy">Polityka prywatności</a>
        </div>
    </footer>

    <!-- SKRYPTY -->
    <script src="/js/Day.js"></script>
    <script src="/js/Clock.js"></script>
    <script src="/js/Light-darkmode.js"></script>
    <script src="/js/Font-size.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            function scrollToNavbar(event) {
                if (event) event.preventDefault();
                var navbarElement = document.getElementById("navbar");
                if (navbarElement) {
                    var navbarOffset = navbarElement.offsetTop;
                    window.scroll({
                        top: navbarOffset,
                        left: 0,
                        behavior: "smooth"
                    });
                }
            }
    </script>
</body>
</html>
   
