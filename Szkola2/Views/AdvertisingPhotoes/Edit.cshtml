@model Szkola2.Models.AdvertisingPhoto

@{
    ViewData["Title"] = "Zamiana zdjęcia";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">EDYCJA</span>
            <h1>Zamień <span>zdjęcie</span></h1>
        </div>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data" class="panel-card panel-narrow">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="PhotoId" />

        <div class="form-field">
            <img class="photo-preview" src="@Url.Content("~/img/mini/" + Model.Photo)" alt="Aktualne zdjęcie" />
        </div>

        <div class="form-field">
            <label for="photo" class="form-label fw-bold">Nowe zdjęcie</label>
            <input type="file" name="photo" id="photo" class="form-control" accept=".jpg,.gif,.png" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-school">Zapisz <span aria-hidden="true">→</span></button>
            <a asp-action="Index" class="btn btn-school-outline">Powrót do zdjęć</a>
        </div>
    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

