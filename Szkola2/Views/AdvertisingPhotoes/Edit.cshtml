@model Szkola2.Models.AdvertisingPhoto

@{
    ViewData["Title"] = "Zamiana";
}

<h1 class="text-primary roboto">Zamień zdjęcie</h1>


<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PhotoId" />
            <div>
                <img src="@Url.Content(Model.Photo = "~/img/mini/"+Model.Photo)"/>
                <br /><br />@* 2 razy br bo nie ma odstępu miedzy guzikiem a obrazkiem*@
                <input type="file" name="photo" id="photo" class="from-control" accept=".jpg,.gif,.png"/>
            </div>
            <div class="form-group">
                <hr />
                <input type="submit" value="Zapisz" class="btn btn-primary" /> |
                <a asp-action="Index" class="btn btn-light">Powrót do zdjęć</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
