@model Szkola2.Models.AdvertisingPhoto

@{
    ViewData["Title"] = "Zamiana";
}

<h1>Zamień zdjęcie</h1>


<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PhotoId" />
            <div>
                <label asp-for="Photo" class="control-label"></label>
                <img src="@Url.Content(Model.Photo = "~/img/zdjecia/"+Model.Photo)" width="150"/>
                <input type="file" name="photo" id="photo" class="from-control" accept=".jpg,.gif,.png"/>
            </div>
            <div class="form-group">
                <input type="submit" value="Zapisz" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-light">Powrót do zdjęć</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
