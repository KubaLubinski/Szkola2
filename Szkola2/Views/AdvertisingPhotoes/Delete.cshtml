@model Szkola2.Models.AdvertisingPhoto

@{
    ViewData["Title"] = "Usuwanie";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg label-danger">UWAGA</span>
            <h1>Usuwanie <span class="heading-danger">zdjęcia</span></h1>
        </div>
    </div>

    <div class="panel-card panel-narrow panel-danger">

        <p class="delete-question">Czy na pewno chcesz usunąć to zdjęcie? Tej operacji nie można cofnąć.</p>

        <img class="photo-preview" src="@Url.Content("~/img/mini/" + Model.Photo)" alt="Zdjęcie do usunięcia" />

        <form asp-action="Delete">
            <input type="hidden" asp-for="PhotoId" />
            <div class="form-actions">
                <button type="submit" class="btn btn-school-danger">Usuń</button>
                <a asp-action="Index" class="btn btn-school-outline">Powrót do zdjęć</a>
            </div>
        </form>

    </div>

</div>
