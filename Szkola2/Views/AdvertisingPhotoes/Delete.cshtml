@model Szkola2.Models.AdvertisingPhoto

@{
    ViewData["Title"] = "Usuwanie";
}

<h1>Usuwanie</h1>

<h3>Czy na pewno chcesz usunąć to zdjęcia?</h3>
<div>
   
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Photo)
        </dt>
        <dd class = "col-sm-10">
            <img src="@Url.Content(Model.Photo = "~/img/zdjecia/"+Model.Photo)" width="150" />
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="PhotoId" />
        <input type="submit" value="Usuń" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-light">Powrót do zdjęć</a>
    </form>
</div>
