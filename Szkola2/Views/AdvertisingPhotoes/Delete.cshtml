@model Szkola2.Models.AdvertisingPhoto

@{
    ViewData["Title"] = "Usuwanie";
}

<h3>Czy na pewno chcesz usunąć to zdjęcie?</h3>
<div>
    <hr />
    <dl class="row">
        <dd class = "col-sm-10">
            <img src="@Url.Content(Model.Photo = "~/img/mini/"+Model.Photo)" />
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="PhotoId" />
        <input type="submit" value="Usuń" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-light">Powrót do zdjęć</a>
    </form>
</div>
