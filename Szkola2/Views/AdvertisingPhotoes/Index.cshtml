@model IEnumerable<Szkola2.Models.AdvertisingPhoto>

@{
    ViewData["Title"] = "Zdjęcia";
}

<h1>Zdjęcia </h1>

<p>
    <a asp-action="Create" class="btn btn-warning">Nowe zdjęcie</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Photo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
               <img src="@Url.Content(item.Photo = "~/img/mini/"+item.Photo)" width="250"/>
            </td>
            <td>
               <a class="btn btn-outline-primary rounded-circle bi-pencil-fill my-1" title="Edycja" asp-action="Edit" asp-route-id="@item.PhotoId">
                    <i  aria-label="Edycja"> Zamień</i></a>
                <a class="btn btn-outline-success rounded-circle bi-eye my-1" title="Podglad" asp-action="Details" asp-route-id="@item.PhotoId">
                    <i  aria-label="Podgląd"> Podgląd</i></a>
                <a class="btn btn-outline-danger rounded-circle bi-trash-fill my-1" title="Usuwanie" asp-action="Delete" asp-route-id="@item.PhotoId">
                    <i  aria-label="Usuwanie"> Usuwanie</i></a>
            </td>
        </tr>
}
    </tbody>
</table>
