@model IEnumerable<Szkola2.Models.AdvertisingPhoto>

@{
    ViewData["Title"] = "Zdjęcia";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">ZARZĄDZANIE</span>
            <h1>Zdjęcia <span>na stronie głównej</span></h1>
        </div>

        <a asp-action="Create" class="btn btn-school">
            Nowe zdjęcie <span aria-hidden="true">+</span>
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="photo-grid">
            @foreach (var item in Model)
            {
                <div class="photo-card">
                    <img src="@Url.Content("~/img/mini/" + item.Photo)" alt="Zdjęcie na stronie głównej" />

                    <div class="photo-card-actions list-actions">
                        <a class="btn btn-outline-success rounded-circle bi-eye"
                           title="Podgląd" aria-label="Podgląd"
                           asp-action="Details" asp-route-id="@item.PhotoId"></a>
                        <a class="btn btn-outline-danger rounded-circle bi-trash-fill"
                           title="Usuń" aria-label="Usuń"
                           asp-action="Delete" asp-route-id="@item.PhotoId"></a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="panel-card texts-empty" role="alert">
            <span class="texts-empty-icon" aria-hidden="true">ℹ</span>
            <div>Brak zdjęć. Dodaj pierwsze zdjęcie przyciskiem „Nowe zdjęcie”.</div>
        </div>
    }

</div>

@section Scripts{ 
    <script src="/js/Mouseover-out.js" > </script>
}
