@model IEnumerable<Szkola2.Models.AdvertisingPhoto>

@{
    ViewData["Title"] = "Zdjęcia";
}

<h1>Zdjęcia </h1>

<p>
    <a asp-action="Create" class="btn btn-warning">Nowe zdjęcie</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Photo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => item.Photo)
               <img src="@Url.Content(item.Photo = "~/img/mini/"+item.Photo)" width="250"/>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PhotoId">Zmiana</a> |
                <a asp-action="Details" asp-route-id="@item.PhotoId">Podgląd</a> |
                <a asp-action="Delete" asp-route-id="@item.PhotoId">Usuń</a>
            </td>
        </tr>
}
    </tbody>
</table>
