@model Szkola2.Models.AdvertisingPhoto

@{
    ViewData["Title"] = "Podgląd";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">PODGLĄD</span>
            <h1>Podgląd <span>zdjęcia</span></h1>
        </div>
    </div>

    <div class="panel-card">
        <img class="photo-preview" src="@Url.Content("~/img/mini/" + Model.Photo)" alt="Podgląd zdjęcia" />

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-school-outline">Powrót do zdjęć</a>
        </div>
    </div>

</div>
