@model Szkola2.Models.AdvertisingPhoto

@{
    ViewData["Title"] = "Podgląd";
}

<h1>Podgląd zdjęcia</h1>

<div>
    
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Photo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Photo)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.PhotoId" class="btn btn-warning" >Zamień zdjęcie</a> |
    <a asp-action="Index" class="btn btn-light" >Powrót do zdjęć </a>
</div>
