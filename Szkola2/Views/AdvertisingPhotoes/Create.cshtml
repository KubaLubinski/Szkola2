@model Szkola2.Models.AdvertisingPhoto

@{
    ViewData["Title"] = "Zdjęcia";
}

<h1>Nowe zdjęcie</h1>
@{
    if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert"> @ViewBag.ErrorMessage</div>
    }
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data" >
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
             <div class="form-group" >
                <label asp-for="Photo" class="control-label"></label>
                <input type="file" name="photo" id="photo" class="form-control" accept=".jpg,.gif,.png" />
                <span asp-validation-for="Photo" class="text-danger"></span>
            </div>   

                <input type="submit" value="Wstaw zdjęcie" class="btn btn-primary" /> |
                <a asp-action="Index" class="btn btn-light">Powrót do zdjęć</a>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
