@model Szkola2.Models.PastSchoolEvent

@{
    ViewData["Title"] = "Edycja wydarzenia";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">EDYCJA</span>
            <h1>Edycja <span>wydarzenia</span></h1>
        </div>
    </div>

    @if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ViewBag.ErrorMessage</div>
    }

    <form asp-action="Edit" enctype="multipart/form-data" class="panel-card panel-narrow">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="MainGraphic" />

        <div class="form-section">
            <h2 class="form-section-title">Wydarzenie</h2>

            <div class="form-field">
                <label asp-for="EventName" class="form-label fw-bold"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="EventDate" class="form-label fw-bold"></label>
                <input asp-for="EventDate" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Content" class="form-label fw-bold"></label>
                <textarea id="editor" asp-for="Content" class="form-control"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
        </div>

        <div class="form-section">
            <h2 class="form-section-title">Zdjęcie główne</h2>

            <div class="form-field">
                <img class="edit-main-photo"
                     src="@Url.Content(Model.MainGraphic == null ? "~/img/mini/brak.jpg" : "~/img/mini/" + Model.MainGraphic)"
                     alt="Aktualne zdjęcie główne" />
                <label asp-for="MainGraphic" class="form-label fw-bold">Zmień zdjęcie główne</label>
                <input type="file" name="picture" id="picture" class="form-control" accept=".jpg,.gif,.png" />
                <span asp-validation-for="MainGraphic" class="text-danger"></span>
            </div>
        </div>

        <div class="form-section">
            <h2 class="form-section-title">Galeria zdjęć</h2>

            @if (Model.GraphicGallery.Count() > 0)
            {
                <div class="gallery-admin-grid">
                    @for (int i = 0; i < Model.GraphicGallery.Count(); i++)
                    {
                        <div class="gallery-admin-item">
                            <img src="@Url.Content("~/miniGallery/" + Model.GraphicGallery[i].URL)"
                                 alt="@Model.GraphicGallery[i].Name" />
                            <button type="button"
                                    class="btn btn-school-danger w-100"
                                    onclick="Delete('/PastSchoolEvents/DeleteOneImage/@Model.GraphicGallery[i].Id')">
                                Usuń
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="muted-text">Brak zdjęć w galerii.</p>
            }

            <div class="form-field">
                <label asp-for="GraphicGalleryFiles" class="form-label fw-bold">Dodaj więcej zdjęć</label>
                <input asp-for="GraphicGalleryFiles" class="form-control" id="customFile" accept=".jpg,.gif,.png">
                <span asp-validation-for="GraphicGalleryFiles" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-school">Zapisz <span aria-hidden="true">→</span></button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-school-outline">Powrót do wpisu</a>
        </div>
    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/ckeditor5/ckeditor.min.js"></script>
    <script src="~/js/DeleteImage.js"></script>
    <script src="~/lib/ckeditor5/translations/pl.min.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'), {
                language: 'pl'
            })
            .catch(error => {
                console.error(error);
            })
    </script>
}
