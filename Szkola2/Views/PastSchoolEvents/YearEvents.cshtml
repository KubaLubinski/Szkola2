@model IEnumerable<Szkola2.Models.PastSchoolEvent>

@{
    ViewData["Title"] = "Wydarzenia z roku szkolnego";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">KALENDARIUM</span>
            <h1>Rok szkolny <span>@ViewBag.SelectedYear/@ViewBag.AfterSelectedYear</span></h1>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="event-list">
            @foreach (var item in Model)
            {
                <article class="event-card">

                    <div class="accordion event-accordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" title="Rozwiń" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#event-collapse-@item.Id"
                                        aria-expanded="false" aria-controls="event-collapse-@item.Id">
                                    <span class="detail-badge">@string.Format("{0:dd.MM.yyyy}", item.EventDate)</span>
                                    <span class="event-title">@item.EventName</span>
                                </button>
                            </h2>

                            <div class="event-card-photo">
                                <img src="@Url.Content(item.MainGraphic == null ? "~/img/mini/brak.jpg" : "~/img/mini/" + item.MainGraphic)"
                                     alt="@item.EventName" />
                            </div>

                            <div id="event-collapse-@item.Id" class="accordion-collapse collapse">
                                <div class="accordion-body">

                                    <div class="detail-content" data-readmore="150">
                                        @Html.Raw(item.Content)
                                    </div>

                                    @if (item.GraphicGallery.Count() > 0)
                                    {
                                        <div id="event-carousel-@item.Id" class="carousel slide gallery-carousel mt-4">
                                            <div class="carousel-inner">
                                                @for (int i = 0; i < item.GraphicGallery.Count(); i++)
                                                {
                                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                                        <img class="d-block img-fluid mx-auto"
                                                             src="@Url.Content("~/miniGallery/" + item.GraphicGallery[i].URL)"
                                                             alt="@($"{item.EventName} – zdjęcie {i + 1} z {item.GraphicGallery.Count()}")">
                                                    </div>
                                                }
                                            </div>

                                            <button class="carousel-control-prev" title="Poprzednie" type="button"
                                                    data-bs-target="#event-carousel-@item.Id" data-bs-slide="prev">
                                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                                <span class="visually-hidden">Poprzednie</span>
                                            </button>
                                            <button class="carousel-control-next" title="Następne" type="button"
                                                    data-bs-target="#event-carousel-@item.Id" data-bs-slide="next">
                                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                                <span class="visually-hidden">Następne</span>
                                            </button>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>
                    </div>

                </article>
            }
        </div>
    }
    else
    {
        <div class="panel-card texts-empty" role="alert">
            <span class="texts-empty-icon" aria-hidden="true">ℹ</span>
            <div>Brak wydarzeń w tym roku szkolnym.</div>
        </div>
    }

    <div class="form-actions border-0 pt-0 mt-0">
        <a asp-action="Index" asp-controller="Home" class="btn btn-school-outline">← Wróć do strony głównej</a>
    </div>

</div>

@section Scripts {
    <script src="~/js/readmore.js"></script>
}






