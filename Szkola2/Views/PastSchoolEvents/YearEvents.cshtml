@using Humanizer
@using System.Globalization
@model IEnumerable<Szkola2.Models.PastSchoolEvent>

@{
    ViewData["Title"] = "YearEvents";
}

<h1 class="text-center text-decoration-underline roboto">Wydarzenia z roku szkolengo @ViewBag.SelectedYear/@ViewBag.AfterSelectedYear</h1>

@{
    var culture = new CultureInfo("en-US");
    int collapseNumber = 0;
    List<string> numberWords = new List<string>();
    for (int i = 2; i <= 100; i++)
    {
        string word = i.ToWords(culture).Transform(To.TitleCase).Replace(" ", "");
        numberWords.Add(word);
    }

    foreach (var item in Model)
    {
        string collapse = numberWords[collapseNumber];
        string collapseId = $"panelsStayOpen-collapse{collapse}";
        string carouselId = $"carousel{collapse}";
        <div class="accordion" id="accordionPanelsStayOpenExample">
            <div class="accordion-item bg-color">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" title="Rozwiń " type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                        <h3 class="fs-3 fw-bold text-decoration-none">@Html.DisplayFor(modelItem => item.EventDate) - @Html.Raw(item.EventName)</h3>
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse">
                    <div class="accordion-body roboto">
                        @Html.Raw(item.Content)
                        <br>
                        @if(item.GraphicGallery.Count() > 0)
                        {
                        <div id="@carouselId" class="carousel slide mx-auto">
                            <div class="carousel-inner col-md-5">
                                @for (int i = 0; i < item.GraphicGallery.Count(); i++)
                                {
                                    <div class="@(i==0 ? "carousel-item active" : "carousel-item") ">
                                        <img class="d-block rounded img-fluid mx-auto" src="@Url.Content("~/miniGallery/"+item.GraphicGallery[i].URL)" alt="@item.GraphicGallery[i].Name">
                                    </div>
                                }
                            </div>
                            <button class="carousel-control-prev custom-carousel-control" title="Poprzednie " type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next custom-carousel-control" title="Następne " type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                        }
                    </div>
                </div>
                <br />
                <div>
                    <img class="d-block rounded img-fluid mx-auto" src="@Url.Content(item.MainGraphic == null ? "~/img/mini/brak.jpg" : "~/img/mini/"+item.MainGraphic)" />
                </div>
                <hr />
            </div>
        </div>
        collapseNumber++;
    }
}



<div>
    <a asp-action="Index" asp-controller="Home" class="btn btn-warning">Wróć do strony głównej</a>
</div>

