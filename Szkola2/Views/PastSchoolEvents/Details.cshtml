@model Szkola2.Models.PastSchoolEvent

@{
    ViewData["Title"] = "Szczegóły wydarzenia";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">WYDARZENIE</span>
            <h1>@Model.EventName</h1>
        </div>
    </div>

    <article class="panel-card">

        <div class="detail-meta">
            <span class="detail-meta-item">
                <span aria-hidden="true">📅</span>
                @string.Format("{0:dd.MM.yyyy}", Model.EventDate)
            </span>
        </div>

        <img class="photo-preview mb-4"
             src="@Url.Content(Model.MainGraphic == null ? "~/img/mini/brak.jpg" : "~/img/mini/" + Model.MainGraphic)"
             alt="@Model.EventName" />

        <div class="detail-content">
            @Html.Raw(Model.Content)
        </div>

        @if (Model.GraphicGallery.Count() > 0)
        {
            <h2 class="form-section-title mt-4">Galeria zdjęć</h2>

            <div id="carouselExample" class="carousel slide gallery-carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.GraphicGallery.Count(); i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img class="d-block img-fluid mx-auto"
                                 src="@Url.Content("~/miniGallery/" + Model.GraphicGallery[i].URL)"
                                 alt="@($"{Model.EventName} – zdjęcie {i + 1} z {Model.GraphicGallery.Count()}")">
                        </div>
                    }
                </div>

                <button class="carousel-control-prev" title="Poprzednie" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Poprzednie</span>
                </button>
                <button class="carousel-control-next" title="Następne" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Następne</span>
                </button>
            </div>
        }

        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-school-warning">Edytuj</a>
            <a asp-action="Index" class="btn btn-school-outline">Powrót do listy</a>
        </div>

    </article>

</div>



