@model Szkola2.Models.Document

@{
    ViewData["Title"] = "Edycja";
}

<h1 class="text-primary roboto">Edycja</h1>

@{
    if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ViewBag.ErrorMessage</div>
    }
   
}
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="DocumentId" />
            <div class="form-group">
                <label asp-for="DocumentDownload" class="control-label"></label>
                <input asp-for="DocumentDownload" class="form-control" />
                <span asp-validation-for="DocumentDownload" class="text-danger"></span>
            </div>

            <div class="form-group editor-color">
                <label asp-for="Content" class="control-label text-color"></label>
                <textarea id="editor" asp-for="Content" class="form-control"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DocumentType" class="control-label"></label>
                <select asp-for="DocumentType" class="form-control">             
                    <option value="Przeglądarka internetowa rozszerzenie .pdf">Przeglądarka internetowa rozszerzenie .pdf</option>
                    <option value="Microsoft Word rozszerzenie .docx">Microsoft Word rozszerzenie .docx .doc</option>
                    <option value="Dokument tekstowy rozszerzenie .txt">Dokument tekstowy rozszerzenie .txt</option>
                </select>
                <span asp-validation-for="DocumentType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DocumentName" class="control-label"></label>
                <input type="file" name="newDocumentFile" id="newDocumentFile" class="form-control" accept=".pdf,.docx,.doc,.txt" onchange="checkFileExtension()" />
                <span asp-validation-for="DocumentName" class="text-danger"></span>
            </div> 
            <hr />
            <div class="form-group">
                <input type="submit" value="Zapisz zmiany" class="btn btn-primary" /> | 
                <a asp-action="Index" class="btn btn-light">Powrót do Dokumentów</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/lib/ckeditor5/ckeditor.min.js"></script>
    <script src="~/lib/ckeditor5/translations/pl.min.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'),{
                language: 'pl'
            })
            .catch(error => {
                console.error(error);
            })
    </script>
    <script>
        document.getElementById('documents').addEventListener('change', function () {
        var selectedFileType = document.getElementById('DocumentType').value;
        var fileInput = document.getElementById('documents');
        var fileName = fileInput.value.split('\\').pop(); // Pobierz nazwę pliku z pełnej ścieżki

        // Sprawdź, czy nazwa pliku zawiera wybrane rozszerzenie
        if (!fileName.endsWith(selectedFileType.substring(selectedFileType.lastIndexOf('.') + 1))) {
            alert('Wybrany plik ma niezgodne rozszerzenie z wybranym typem dokumentu.');
            // Możesz dodać dalsze działania, np. zablokować wysyłkę formularza lub wyczyścić pole input pliku.
            fileInput.value = '';
        }
    });
    </script>
}
