@model Szkola2.Models.Document

@{
    ViewData["Title"] = "Usuwanie dokumentu";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg label-danger">UWAGA</span>
            <h1>Usuwanie <span class="heading-danger">dokumentu</span></h1>
        </div>
    </div>

    <div class="panel-card panel-narrow panel-danger">

        <p class="delete-question">Czy na pewno chcesz usunąć wybrany dokument? Tej operacji nie można cofnąć.</p>

        <dl class="detail-list">
            <dt>@Html.DisplayNameFor(model => model.DocumentDownload)</dt>
            <dd>@Html.DisplayFor(model => model.DocumentDownload)</dd>

            <dt>@Html.DisplayNameFor(model => model.DocumentType)</dt>
            <dd>@Html.DisplayFor(model => model.DocumentType)</dd>
        </dl>

        <h2 class="form-section-title mt-4">@Html.DisplayNameFor(model => model.Content)</h2>
        <div class="detail-content delete-content">
            @Html.Raw(Model.Content)
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="DocumentId" />
            <div class="form-actions">
                <button type="submit" class="btn btn-school-danger">Usuń</button>
                <a asp-action="Index" class="btn btn-school-outline">Powrót do dokumentów</a>
            </div>
        </form>

    </div>

</div>
