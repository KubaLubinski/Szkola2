@model Szkola2.Models.Document

@{
    ViewData["Title"] = "Usuwanie";
}

<h1 class="text-danger roboto">Usuwanie</h1>

<h3 class="roboto">Czy napewno chcesz usunąć wybrany dokument</h3>
<div>

    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DocumentDownload)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DocumentDownload)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Content)
        </dt>
        <dd class = "col-sm-10">
            @Html.Raw(Model.Content)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DocumentType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DocumentType)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="DocumentId" />
        <hr />
        <input type="submit" value="Usuwanie" class="btn btn-danger" /> | 
        <a asp-action="Index" class="btn btn-light">Powrót do dokumentów</a>
    </form>
</div>
