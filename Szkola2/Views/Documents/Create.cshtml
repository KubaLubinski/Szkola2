@model Szkola2.Models.Document

@{
    ViewData["Title"] = "Dodaj dokument";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">NOWY PLIK</span>
            <h1>Dodaj <span>dokument</span></h1>
        </div>
    </div>

    @if (!String.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ViewBag.ErrorMessage</div>
    }

    <form asp-action="Create" enctype="multipart/form-data" class="panel-card panel-narrow">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-section">
            <h2 class="form-section-title">Opis</h2>

            <div class="form-field">
                <label asp-for="DocumentDownload" class="form-label fw-bold"></label>
                <input asp-for="DocumentDownload" class="form-control" />
                <span asp-validation-for="DocumentDownload" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Content" class="form-label fw-bold"></label>
                <textarea id="editor" asp-for="Content" class="form-control"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
        </div>

        <div class="form-section">
            <h2 class="form-section-title">Plik</h2>

            <div class="form-field">
                <label asp-for="DocumentType" class="form-label fw-bold"></label>
                <select asp-for="DocumentType" class="form-select">
                    <option value="Przeglądarka internetowa rozszerzenie .pdf">Przeglądarka internetowa rozszerzenie .pdf</option>
                    <option value="Microsoft Word rozszerzenie .docx">Microsoft Word rozszerzenie .docx .doc</option>
                    <option value="Dokument tekstowy rozszerzenie .txt">Dokument tekstowy rozszerzenie .txt</option>
                </select>
                <span asp-validation-for="DocumentType" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="DocumentName" class="form-label fw-bold"></label>
                <input type="file" name="documents" id="documents" class="form-control" accept=".pdf,.docx,.doc,.txt" />
                <span asp-validation-for="DocumentName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-school">Dodaj <span aria-hidden="true">→</span></button>
            <a asp-action="Index" class="btn btn-school-outline">Powrót do dokumentów</a>
        </div>
    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/ckeditor5/ckeditor.min.js"></script>
    <script src="~/lib/ckeditor5/translations/pl.min.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'), {
                language: 'pl'
            })
            .catch(error => {
                console.error(error);
            })
    </script>
    <script>
        (function () {
            var fileInput = document.getElementById('documents');
            var typeSelect = document.getElementById('DocumentType');
            if (!fileInput || !typeSelect) return;

            fileInput.addEventListener('change', function () {
                if (!fileInput.value) return;

                var fileName = fileInput.value.split('\\').pop().toLowerCase();
                var ext = fileName.substring(fileName.lastIndexOf('.') + 1);

                var typeExt = typeSelect.value.substring(typeSelect.value.lastIndexOf('.') + 1).toLowerCase();
                var allowed = typeExt === 'docx' ? ['docx', 'doc'] : [typeExt];

                if (allowed.indexOf(ext) === -1) {
                    alert('Wybrany plik ma niezgodne rozszerzenie z wybranym typem dokumentu.');
                    fileInput.value = '';
                }
            });
        })();
    </script>
}

