@model Szkola2.Models.Document

@{
    ViewData["Title"] = "Szczegóły dokumentu";
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">DOKUMENT</span>
            <h1>@Html.DisplayFor(model => model.DocumentDownload)</h1>
        </div>
    </div>

    <div class="panel-card panel-narrow">

        <dl class="detail-list">
            <dt>@Html.DisplayNameFor(model => model.DocumentDownload)</dt>
            <dd>@Html.DisplayFor(model => model.DocumentDownload)</dd>

            <dt>@Html.DisplayNameFor(model => model.DocumentName)</dt>
            <dd>@Html.DisplayFor(model => model.DocumentName)</dd>

            <dt>@Html.DisplayNameFor(model => model.DocumentType)</dt>
            <dd>@Html.DisplayFor(model => model.DocumentType)</dd>
        </dl>

        <h2 class="form-section-title mt-4">@Html.DisplayNameFor(model => model.Content)</h2>
        <div class="detail-content">
            @Html.Raw(Model.Content)
        </div>

        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model?.DocumentId" class="btn btn-school-warning">Edycja</a>
            <a asp-action="Index" class="btn btn-school-outline">Powrót do dokumentów</a>
        </div>

    </div>

</div>
