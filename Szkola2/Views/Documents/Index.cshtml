@using System.IO
@model IEnumerable<Szkola2.Models.Document>

@{
    ViewData["Title"] = "Lista dokumentów";
    bool canEdit = User.IsInRole("admin") || User.IsInRole("dyrektor") || User.IsInRole("nauczyciel") || User.IsInRole("uczeń");
}

<div class="school-home">

    <div class="page-heading">
        <div>
            <span class="section-label section-label-lg">DO POBRANIA</span>
            <h1>Lista <span>dokumentów</span></h1>
        </div>

        @if (canEdit)
        {
            <a asp-action="Create" class="btn btn-school">
                Dodaj nowy plik <span aria-hidden="true">+</span>
            </a>
        }
    </div>

    @if (Model.Any())
    {
        <div class="doc-grid">
            @foreach (var item in Model)
            {
                string fileName = item.DocumentName ?? "";
                int lastDotIndex = fileName.LastIndexOf('.');
                string extension = lastDotIndex >= 0 ? fileName.Substring(lastDotIndex + 1).ToLower() : string.Empty;

                string logoSrc = extension switch
                {
                    "txt" => Url.Content("~/img/logo/txt-logo.png"),
                    "docx" or "doc" => Url.Content("~/img/logo/docx-logo.png"),
                    "pdf" => Url.Content("~/img/logo/pdf-logo.png"),
                    _ => ""
                };

                <article class="doc-card">
                    <div class="doc-card-icon">
                        @if (!string.IsNullOrEmpty(logoSrc))
                        {
                            <img src="@logoSrc" alt="Ikona pliku @extension" />
                        }
                        else
                        {
                            <i class="bi bi-file-earmark" aria-hidden="true"></i>
                        }
                    </div>

                    <div class="doc-card-body">
                        <h3>@Html.DisplayFor(modelItem => item.DocumentDownload)</h3>
                        <div class="doc-card-text">@Html.Raw(item.Content)</div>
                    </div>

                    <div class="doc-card-footer">
                        <a href="@Url.Content("~/documents/" + item.DocumentName)" download title="Pobierz"
                           class="btn btn-school doc-download">
                            <i class="bi bi-file-earmark-arrow-down-fill" aria-hidden="true"></i> Pobierz
                        </a>

                        @if (canEdit)
                        {
                            <span class="list-actions">
                                <a asp-action="Edit" asp-route-id="@item.DocumentId" title="Edycja" aria-label="Edycja"
                                   class="btn btn-outline-primary rounded-circle bi-pencil-fill"></a>
                                <a asp-action="Delete" asp-route-id="@item.DocumentId" title="Usuwanie" aria-label="Usuwanie"
                                   class="btn btn-outline-danger rounded-circle bi-trash-fill"></a>
                            </span>
                        }
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="panel-card texts-empty" role="alert">
            <span class="texts-empty-icon" aria-hidden="true">ℹ</span>
            <div>Brak dokumentów do pobrania.</div>
        </div>
    }

</div>