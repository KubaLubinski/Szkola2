@using System.IO
@model IEnumerable<Szkola2.Models.Document>

@{
    ViewData["Title"] = "Index";
}

<h1 class="roboto">Lista Dokumentów</h1>
@{
    if(User.IsInRole("admin") || User.IsInRole("dyrektor") || User.IsInRole("nauczyciel") || User.IsInRole("uczeń") )
    {
        <p>
    
            <a asp-action="Create" class="btn btn-warning">Dodaj Nowy plik </a>
        </p>
    }
}
<table class="table text-color">
    <thead>
        <tr>
            <th>
                Pobierz dokument:
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DocumentDownload)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Content)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DocumentType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @{
                    string fileName = item.DocumentName;
                    int lastDotIndex = fileName.LastIndexOf('.');
                    string extension = lastDotIndex >= 0 ? fileName.Substring(lastDotIndex) : string.Empty;
                } @* użycie razor do pobrania rozszerzenia *@
                 <a href="@Url.Content("~/documents/" + item.DocumentName)" download onmouseover="showtips(this, 'Kliknij aby pobrać ')" onmouseout="hidetips()" > @item.DocumentDownload @extension </a>
                 <div class="tooltip" id="tooltips">Podpowiedź</div>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DocumentDownload)
            </td>
            <td>
                @Html.Raw(item.Content)
            </td>
            <td >
                @Html.DisplayFor(modelItem => item.DocumentType)
            </td>
            <td>

                @{
                    if(User.IsInRole("admin") || User.IsInRole("dyrektor") || User.IsInRole("nauczyciel") || User.IsInRole("uczeń") )
                    {
                            <a asp-action="Edit" asp-route-id="@item.DocumentId" class="btn btn-outline-primary rounded-circle bi-pencil-fill" onmouseover="showtip(this, 'Edytuj ')" onmouseout="hidetip()" > </a> <br>
                            <a asp-action="Delete" asp-route-id="@item.DocumentId" class="btn btn-outline-danger rounded-circle bi-trash-fill" onmouseover="showtip(this, 'Usuń ')" onmouseout="hidetip()" > </a><br>
                    }
                 }
                 <div class="tooltip" id="tooltip">Podpowiedź</div>

            </td>
        </tr>
}
    </tbody>
</table>
@section Scripts{ 
    <script src="/js/Mouseover-out.js" > </script>
    <script>
    function showtips(element, text) {
    var tooltips = document.getElementById('tooltips');
    tooltips.innerText = text;
    tooltips.classList.add('show');

    // Pobierz pozycję myszki
    var rect = element.getBoundingClientRect();
    var mouseX = rect.left + window.scrollX;
    var mouseY = rect.top + window.scrollY;

    // Ustaw przesunięcie w poziomie i pionie
    var offsetX = 45; // Przesunięcie w poziomie
    var offsetY = 45; // Przesunięcie w pionie

    // Ustaw pozycję dymku podpowiedzi
    tooltips.style.left = (mouseX + offsetX) + 'px';
    tooltips.style.top = (mouseY + offsetY) + 'px';
}

function hidetips() {
    var tooltips = document.getElementById('tooltips');
    tooltips.classList.remove('show');
}
    </script>
}

