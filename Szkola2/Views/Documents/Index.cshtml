@model IEnumerable<Szkola2.Models.Document>

@{
    ViewData["Title"] = "Index";
}

<h1>Lista Dokumentów</h1>
@{
    if(User.IsInRole("admin") || User.IsInRole("dyrektor") || User.IsInRole("nauczyciel") || User.IsInRole("uczeń") )
    {
        <p>
    
            <a asp-action="Create" class="btn btn-warning">Dodaj Nowy plik </a>
        </p>
    }
}
<table class="table text-color">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DocumentDownload)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DocumentName)
            </th>
            <th class="d-none d-md-block">
                @Html.DisplayNameFor(model => model.DocumentType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                 <a href="@Url.Content("~/documents/" + item.DocumentName)" download>@item.DocumentDownload</a>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DocumentDownload)
            </td>
            <td >
                @Html.DisplayFor(modelItem => item.DocumentType)
            </td>
            <td>

                @{
                    if(User.IsInRole("admin") || User.IsInRole("dyrektor") || User.IsInRole("nauczyciel") || User.IsInRole("uczeń") )
                    {
                            <a asp-action="Edit" asp-route-id="@item.DocumentId" class="btn btn-outline-primary rounded-circle bi-pencil-fill" > Edycja</a> <br>
                            <a asp-action="Delete" asp-route-id="@item.DocumentId" class="btn btn-outline-danger rounded-circle bi-trash-fill" > Usuwanie</a><br>
                    }
                 }

            </td>
        </tr>
}
    </tbody>
</table>
