@using System.IO
@model IEnumerable<Szkola2.Models.Document>

@{
    ViewData["Title"] = "Index";
}

<h1 class="roboto">Lista Dokumentów</h1>
@{
    if(User.IsInRole("admin") || User.IsInRole("dyrektor") || User.IsInRole("nauczyciel") || User.IsInRole("uczeń") )
    {
        <p>
    
            <a asp-action="Create" class="btn btn-warning">Dodaj Nowy plik </a>
        </p>
    }
}
@foreach (var item in Model)
{
    <div class="card container left-document text-center  bg-color col-sm-4 shadow-document">
        @{
            string fileName = item.DocumentName;
            int lastDotIndex = fileName.LastIndexOf('.');
            string extension = lastDotIndex >= 0 ? fileName.Substring(lastDotIndex + 1).ToLower() : string.Empty;

            string logoSrc = "";
            switch (extension)
                {
                    case "txt":
                        logoSrc = Url.Content("~/img/logo/txt-logo.png");
                        break;
                    case "docx":
                        logoSrc = Url.Content("~/img/logo/docx-logo.png");
                        break;
                    case "pdf":
                        logoSrc = Url.Content("~/img/logo/pdf-logo.png");
                        break;   
                }
        }
        <img id="logo-document" src="@logoSrc" class="card-img-top logo-document" alt="Logo dokumentu">
        
        <div class="card-body text-size-document">
            <h3 class="card-title roboto"> @Html.DisplayFor(modelItem => item.DocumentDownload) </h3>
            <p class="card-text"> @Html.Raw(item.Content) </p>
            <a href="@Url.Content("~/documents/" + item.DocumentName)" download onmouseover="showtips(this, 'Kliknij aby pobrać ')" onmouseout="hidetips()" class="btn btn-info bi bi-file-earmark-arrow-down-fill width-btn-download position-absolute bottom-20-document end-0"  > Pobierz >>> </a>
            <p>
                @{
                    if(User.IsInRole("admin") || User.IsInRole("dyrektor") || User.IsInRole("nauczyciel") || User.IsInRole("uczeń") )
                    {
                            <a asp-action="Edit" asp-route-id="@item.DocumentId" class="btn btn-outline-primary rounded-circle bi-pencil-fill position-absolute bottom-0 end-10-document" onmouseover="showtips(this, 'Edytuj ')" onmouseout="hidetips()" > </a>
                            <a asp-action="Delete" asp-route-id="@item.DocumentId" class="btn btn-outline-danger rounded-circle bi-trash-fill position-absolute bottom-0" onmouseover="showtips(this, 'Usuń ')" onmouseout="hidetips()" > </a><br>
                    }
                 }
                 <div class="tooltip" id="tooltip">Podpowiedź</div>
           </p>
        </div>
        
    </div>
}





@section Scripts{ 
    <script src="/js/Mouseover-out.js" > </script>
    <script>
    function showtips(element, text) {
    var tooltips = document.getElementById('tooltips');
    tooltips.innerText = text;
    tooltips.classList.add('show');

    // Pobierz pozycję myszki
    var rect = element.getBoundingClientRect();
    var mouseX = rect.left + window.scrollX;
    var mouseY = rect.top + window.scrollY;

    // Ustaw przesunięcie w poziomie i pionie
    var offsetX = 20; // Przesunięcie w poziomie
    var offsetY = 40; // Przesunięcie w pionie

    // Ustaw pozycję dymku podpowiedzi
    tooltips.style.left = (mouseX + offsetX) + 'px';
    tooltips.style.top = (mouseY + offsetY) + 'px';
}

function hidetips() {
    var tooltips = document.getElementById('tooltips');
    tooltips.classList.remove('show');
}
    </script>
}

