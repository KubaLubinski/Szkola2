@page
@model RegisterModel
@{
    ViewData["Title"] = "Tworzenie nowego użytkownika";
}
<h1 class="text-success roboto">Tworzenie nowego użytkownika</h1>
<div class="row">
    <div class="col-lg-5 col-md-8 text-dark">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-floating">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="Input.FirstName" class="form-control" />
                <label asp-for="Input.FirstName"></label>
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="Input.LastName" class="form-control" />
                <label asp-for="Input.LastName"></label>
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="Input.Information" class="form-control" />
                <label asp-for="Input.Information"></label>
                <span asp-validation-for="Input.Information" class="text-danger"></span>
            </div>
            <hr />
            <div class="form-floating text-color">
                <label asp-for="Input.IsActive" class="form-check-label"></label>
                <input asp-for="Input.IsActive" class="form-check-input" />
                <span asp-validation-for="Input.IsActive" class="text-danger"></span>
            </div>
            <hr />
            <div class="form-floating text-color">
                <label asp-for="Input.CanAddTexts" class="form-check-label"></label>
                <input asp-for="Input.CanAddTexts" class="form-check-input" />
                <span asp-validation-for="Input.CanAddTexts" class="text-danger"></span>
            </div>
            <hr />
            <div class="form-group">
                <label asp-for="Input.UserRole" class="text-color"></label>
                <select asp-for="Input.UserRole" class="form-control text-center" asp-items="Model.RoleItems">
                    <option value="">-- Wybierz role --</option>
                </select>
                <span asp-validation-for="Input.UserRole" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                <label asp-for="Input.Password">Hasło</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <label asp-for="Input.ConfirmPassword">Potwierdź hasło</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <hr/>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Zatwierdź</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
