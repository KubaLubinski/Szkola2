@page
@model LoginModel
@{
    ViewData["Title"] = "Logowanie";
}

<div class="school-home">

    <div class="panel-card auth-card">

        <img src="~/img/logo/logo_duze.png" class="auth-logo" alt="Logo Szkoły Podstawowej w Goleszynie" />

        <div class="auth-head">
            <h1>Witamy na stronie <span>logowania</span></h1>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-field">
                <label asp-for="Input.Email" class="form-label fw-bold">E-mail</label>
                <div class="input-group">
                    <span class="input-group-text" aria-hidden="true"><i class="bi bi-person-circle"></i></span>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Input.Haslo" class="form-label fw-bold">Hasło</label>
                <div class="input-group">
                    <span class="input-group-text" aria-hidden="true"><i class="bi bi-key-fill"></i></span>
                    <input asp-for="Input.Haslo" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Hasło" />
                </div>
                <span asp-validation-for="Input.Haslo" class="text-danger"></span>
            </div>

            <div class="form-check auth-remember">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe"></label>
            </div>

            <button id="login-submit" type="submit" class="btn btn-school btn-school-lg">
                Zaloguj się <span aria-hidden="true">→</span>
            </button>
        </form>

        <hr class="my-4" />

        <div class="text-center">
            <p class="muted-text mb-2">Chcesz tylko obejrzeć stronę od środka?</p>
            <form asp-controller="Demo" asp-action="Start" method="post">
                <button type="submit" class="btn btn-school-outline">
                    Wypróbuj konto testowe <span aria-hidden="true">→</span>
                </button>
            </form>
            <p class="muted-text small mt-2">
                Jednorazowe konto, które wygasa po 2 godzinach. Zobaczysz panel administracyjny
                i możesz dodać własne wpisy – nikt poza Tobą ich nie zobaczy.
            </p>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
