@page
@model LoginModel

@{
    ViewData["Title"] = "Logowanie";
}
<div class="container d-flex justify-content-center">
    <div class="col-md-6 text-center">
        <section class="login-img img-fluid">
            <form id="account" method="post" class="login">
                <h2 class="roboto">Witamy na stronie szkoły</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="input-group">
                <span class="input-group-text login-icon">
                    <i class="bi bi-person-circle"></i>
                </span>
                <div class="form-floating login-width">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                    <label asp-for="Input.Email" class="form-label text-dark"></label>
                </div>
            </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                <hr />
            <div class="input-group">
                <span class="input-group-text login-icon">
                    <i class="bi bi-key-fill"></i>
                </span>
                <div class="form-floating login-width">
                    <input asp-for="Input.Haslo" class="form-control" autocomplete="current-password" aria-required="true" />
                    <label asp-for="Input.Haslo" class="form-label text-dark width"></label>
                </div>
            </div>
                    <span asp-validation-for="Input.Haslo" class="text-danger"></span>          
                    <div class="checkbox">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Zaloguj się</button>
                </div>          
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
