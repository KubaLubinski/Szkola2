@page
@model LoginModel
@{
    ViewData["Title"] = "Logowanie";
}
<div class="row my-5">
    <div class="rounded  shadow text-center p-3 col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-lg-3 col-xl-4 offset-xl-4">
        <img src="~/img/logo/logo-goleszyna.png" class="login-photo img-fluid mb-2" alt="logo szkoły" height="400" width="300"  ></img>
        <hr />
        <section>
            <form id="account" method="post">
                <h2 class="roboto">Witamy na stronie logowania</h2>           
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="input-group margin-login">
                    <span class="input-group-text login-icon">
                        <i class="bi bi-person-circle"></i>
                    </span>
                    <div class="form-floating login-width">
                        <input asp-for="Input.Email" class="form-control" id="floatingInput" placeholder="name@example.com" autocomplete="username" aria-required="true"/>
                        <label for="floatingInput" class="text-dark">E-mail</label>
                    </div>
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
                <div class="input-group">
                    <span class="input-group-text login-icon">
                        <i class="bi bi-key-fill"></i>
                    </span>
                    <div class="form-floating login-width">
                        <input asp-for="Input.Haslo" type="password" class="form-control" id="floatingPassword" placeholder="Password">
                        <label for="floatingPassword" class="text-dark">Hasło</label>
                    </div>
                </div>
                <span asp-validation-for="Input.Haslo" class="text-danger"></span>
                <div class="text-center mt-2">
                    <div class="checkbox">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary margin-login">Zaloguj się</button>
                </div>   
            </form>
        </section>
    </div>
    <div class="col-md-6 d-none d-sm-block d-flex">
        <section>
            <div> 
                
            </div>
        </section>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}