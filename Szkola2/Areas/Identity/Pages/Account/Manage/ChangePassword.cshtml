@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Zmiana hasła";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="school-home">

    <div class="panel-card auth-card">

        <img src="~/img/logo/logo_duze.png" class="auth-logo" alt="Logo Szkoły Podstawowej w Goleszynie" />

        <div class="auth-head">
            <h1>Zmiana <span>hasła</span></h1>
        </div>

        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-field">
                <label asp-for="Input.OldPassword" class="form-label fw-bold">Stare hasło</label>
                <div class="input-group">
                    <span class="input-group-text" aria-hidden="true"><i class="bi bi-shield-slash-fill"></i></span>
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Stare hasło" />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Input.NewPassword" class="form-label fw-bold">Nowe hasło</label>
                <div class="input-group">
                    <span class="input-group-text" aria-hidden="true"><i class="bi bi-shield-fill-plus"></i></span>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nowe hasło" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-bold">Powtórz nowe hasło</label>
                <div class="input-group">
                    <span class="input-group-text" aria-hidden="true"><i class="bi bi-shield-fill-check"></i></span>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Powtórz nowe hasło" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-school btn-school-lg">
                Zmień hasło <span aria-hidden="true">→</span>
            </button>
        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
