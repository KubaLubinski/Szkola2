@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Zmiana Hasła";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="row my-5">
    <div class="rounded  shadow text-center p-3 col-10 offset-1 col-md-8 offset-md-2 col-lg-6 offset-lg-3 col-xl-4 offset-xl-4">
        <img src="~/img/logo/logo-goleszyna.png" class="login-photo img-fluid mb-2" alt="logo szkoły" height="400" width="300"  ></img>
        <hr />
        <form id="change-password-form" method="post">
            <h2 class="roboto text-primary">@ViewData["Title"]</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="input-group margin-login mt-3">
                <span class="input-group-text login-icon">
                        <i class="bi bi-shield-slash-fill"></i>
                </span>
                <div class="form-floating login-width">
                <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Stare Hasło" />
                <label for="floatingInput" class="text-dark">Stare Hasło</label>
                </div>
            </div>
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            <div class="input-group margin-login">
                <span class="input-group-text login-icon">
                        <i class="bi bi-shield-fill-plus"></i>
                </span>
                <div class="form-floating login-width">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nowe Hasło" />
                <label for="floatingInput" class="text-dark">Nowe Hasło</label>
                </div>
            </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            
            <div class="input-group margin-login">
                <span class="input-group-text login-icon">
                        <i class="bi bi-shield-fill-check"></i>
                </span>
                <div class="form-floating login-width">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Potworz nowe hasło" />
                <label for="floatingInput" class="text-dark">Powtórz Nowe Hasło</label>          </div>
            </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            
            <button type="submit" class="w-100 btn btn-lg btn-primary">Zmień hasło </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
